{% doc %}
  @prompt
    collection list
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-list-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-list-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-collection-list-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-list-{{ ai_gen_id }}__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-list-{{ ai_gen_id }}__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f4f4f4;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-collection-list-{{ ai_gen_id }}__media img,
  .ai-collection-list-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-list-{{ ai_gen_id }}__title {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
  }

  .ai-collection-list-{{ ai_gen_id }}__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ai-collection-list-{{ ai_gen_id }}__empty {
    padding: 20px;
    background: #f4f4f4;
    border-radius: {{ block.settings.corner_radius }}px;
    color: #333333;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-list-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.gap | times: 0.75 }}px;
    }

    .ai-collection-list-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
      margin-bottom: 18px;
    }

    .ai-collection-list-{{ ai_gen_id }}__title {
      font-size: 14px;
      margin-top: 9px;
    }
  }
{% endstyle %}

<div class="ai-collection-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-collection-list-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.collections != blank %}
    <div class="ai-collection-list-{{ ai_gen_id }}__grid">
      {% for collection in block.settings.collections %}
        <a class="ai-collection-list-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
          <span class="ai-collection-list-{{ ai_gen_id }}__media">
            {% if collection.featured_image %}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', alt: collection.featured_image.alt | default: collection.title | escape }}
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </span>
          <h3 class="ai-collection-list-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-collection-list-{{ ai_gen_id }}__empty">Choose collections in the block settings to display them here.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Item spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Collection list"
    }
  ],
  "tag": null,
  "class": "collection-list-block"
}
{% endschema %}