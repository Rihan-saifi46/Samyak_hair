{% doc %}
  Header Logo Component for Samyak Hair Accessories
  Renders the stylized emerald-green & gold "SAMYAK — HAIR ACCESSORIES" logo (height: 54px).
{% enddoc %}

<a
  href="{{ routes.root_url }}"
  class="samyak-header-logo-link header-logo"
  aria-label="SAMYAK HAIR ACCESSORIES"
  {{ block.shopify_attributes }}
>
  <img
    src="{{ 'samyak-logo-emerald.jpg' | asset_url }}"
    alt="SAMYAK HAIR ACCESSORIES"
    class="samyak-header-logo-img"
    width="220"
    height="54"
    loading="eager"
    fetchpriority="high"
  >
</a>

<style>
  .samyak-header-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    margin: 0;
    padding: 0;
  }

  .samyak-header-logo-img {
    height: 54px;
    width: auto;
    max-height: 54px;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .samyak-header-logo-img {
      height: 42px;
      max-height: 42px;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "class": "header-logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "t:settings.hide_logo_on_home_page",
      "info": "t:info.hide_logo_on_home_page_help"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
