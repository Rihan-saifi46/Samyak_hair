  }
</style>

<script>
  (function() {
    var rawCartTotal = {{ cart.total_price }};
    var activeDiscountRate = 0; // 0.10 for 10%
    var activeCouponCode = '';

    function formatMoney(cents) {
      return '₹' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Check existing stored coupon
    try {
      var savedCoupon = sessionStorage.getItem('samyak_applied_coupon');
      if (savedCoupon === 'SAMYAK10') {
        applyCouponCode('SAMYAK10', false);
      }
    } catch(e) {}

    // Quantity buttons
    var qtyButtons = document.querySelectorAll('.samyak-page-qty-btn, .samyak-page-row-remove');
    qtyButtons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var action = this.getAttribute('data-action');
        var key = this.getAttribute('data-key');
        var newQty = 0;

        if (action === 'dec' || action === 'inc') {
          newQty = parseInt(this.getAttribute('data-qty'), 10);
        } else if (action === 'remove') {
          newQty = 0;
        }

        if (newQty < 0) newQty = 0;
        updateCartLineItem(key, newQty);
      });
    });

    // Quantity manual input change
    var qtyInputs = document.querySelectorAll('.samyak-page-qty-input');
    qtyInputs.forEach(function(inp) {
      inp.addEventListener('change', function() {
        var key = this.getAttribute('data-key');
        var newQty = parseInt(this.value, 10);
        if (isNaN(newQty) || newQty < 0) newQty = 0;
        updateCartLineItem(key, newQty);
      });
    });

    function updateCartLineItem(key, quantity) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ id: key, quantity: quantity })
      })
      .then(function(res) { return res.json(); })
      .then(function(cart) {
        // Reload page smoothly to refresh liquid line calculations or if empty
        if (cart.item_count === 0) {
          window.location.reload();
          return;
        }
        window.location.reload();
      })
      .catch(function(err) {
        console.error('Error updating cart line item:', err);
      });
    }

    // Coupon logic
    var couponInput = document.getElementById('samyak-coupon-input');
    var applyBtn = document.getElementById('samyak-coupon-apply-btn');
    var fastApplyBtn = document.getElementById('samyak-coupon-fast-apply');
    var feedbackEl = document.getElementById('samyak-coupon-feedback');

    if (applyBtn && couponInput) {
      applyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var code = (couponInput.value || '').trim().toUpperCase();
        if (!code) {
          showFeedback('Please enter a coupon code.', 'is-error');
          return;
        }
        applyCouponCode(code, true);
      });
    }

    if (fastApplyBtn) {
      fastApplyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var code = this.getAttribute('data-code') || 'SAMYAK10';
        if (couponInput) couponInput.value = code;
        applyCouponCode(code, true);
      });
    }

    function showFeedback(msg, cls) {
      if (!feedbackEl) return;
      feedbackEl.textContent = msg;
      feedbackEl.className = 'samyak-coupon-feedback ' + cls;
      feedbackEl.classList.remove('is-hidden');
    }

    function applyCouponCode(code, showMsg) {
      if (code === 'SAMYAK10') {
        // Minimum order ₹2,000 (200000 cents)
        if (rawCartTotal < 200000) {
          if (showMsg) {
            showFeedback('SAMYAK10 requires a minimum order value of ₹2,000.', 'is-error');
          }
          activeDiscountRate = 0;
          activeCouponCode = '';
          updateSummaryDisplay();
          return;
        }

        activeDiscountRate = 0.10;
        activeCouponCode = 'SAMYAK10';
        try { sessionStorage.setItem('samyak_applied_coupon', 'SAMYAK10'); } catch(e) {}

        if (showMsg) {
          showFeedback('✓ Coupon SAMYAK10 applied! 10% wholesale discount activated.', 'is-success');
        }
        updateSummaryDisplay();
      } else {
        if (showMsg) {
          showFeedback('Invalid coupon code. Try SAMYAK10 for 10% off.', 'is-error');
        }
      }
    }

    function updateSummaryDisplay() {
      var subtotalEl = document.getElementById('samyak-sum-subtotal');
      var discountRow = document.getElementById('samyak-discount-row');
      var discountValEl = document.getElementById('samyak-sum-discount');
      var activeCodeEl = document.getElementById('samyak-active-code');
      var totalValEl = document.getElementById('samyak-sum-total');

      if (subtotalEl) subtotalEl.textContent = formatMoney(rawCartTotal);

      var effectiveTotal = rawCartTotal;
      if (activeDiscountRate > 0) {
        var discountAmount = Math.round(rawCartTotal * activeDiscountRate);
        effectiveTotal = rawCartTotal - discountAmount;

        if (discountRow) discountRow.classList.remove('is-hidden');
        if (activeCodeEl) activeCodeEl.textContent = activeCouponCode;
        if (discountValEl) discountValEl.textContent = '-' + formatMoney(discountAmount);
        if (totalValEl) totalValEl.textContent = formatMoney(effectiveTotal);
      } else {
        if (discountRow) discountRow.classList.add('is-hidden');
        if (totalValEl) totalValEl.textContent = formatMoney(rawCartTotal);
      }

      // Update wholesale MOQ progress & checkout button state dynamically
      var moqProgress = document.querySelector('.samyak-cart-wholesale-progress');
      var moqStatus = document.querySelector('.samyak-cart-wholesale-status');
      var moqWarn = document.getElementById('samyak-cart-moq-warning');
      var checkoutBtn = document.getElementById('samyak-checkout-submit');

      if (rawCartTotal >= 200000) {
        if (moqProgress) moqProgress.style.width = '100%';
        if (moqStatus) {
          moqStatus.className = 'samyak-cart-wholesale-status is-met';
          moqStatus.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> <strong>Wholesale Minimum (₹2,000) reached!</strong>';
        }
        if (moqWarn) moqWarn.style.display = 'none';
        if (checkoutBtn) {
          checkoutBtn.disabled = false;
          checkoutBtn.removeAttribute('aria-disabled');
          checkoutBtn.classList.remove('is-disabled');
        }
      } else {
        var pct = Math.min(100, Math.round((rawCartTotal / 200000) * 100));
        var diff = 200000 - rawCartTotal;
        if (moqProgress) moqProgress.style.width = pct + '%';
        if (moqStatus) {
          moqStatus.className = 'samyak-cart-wholesale-status';
          moqStatus.innerHTML = 'Wholesale MOQ: Add <strong>' + formatMoney(diff) + '</strong> more to reach <strong>₹2,000</strong>';
        }
        if (moqWarn) moqWarn.style.display = 'flex';
        if (checkoutBtn) {
          checkoutBtn.disabled = true;
          checkoutBtn.setAttribute('aria-disabled', 'true');
          checkoutBtn.classList.add('is-disabled');
        }
      }
    }

    // Intercept form submission if below wholesale MOQ
    var cartForm = document.getElementById('samyak-main-cart-form');
    if (cartForm) {
      cartForm.addEventListener('submit', function(e) {
        if (rawCartTotal < 200000) {
          e.preventDefault();
          e.stopPropagation();
          var warn = document.getElementById('samyak-cart-moq-warning');
          if (warn) {
            warn.scrollIntoView({ behavior: 'smooth', block: 'center' });
            warn.classList.add('is-shaking');
            setTimeout(function() { warn.classList.remove('is-shaking'); }, 600);
          }
          return false;
        }
      });
    }

    // Checkout submission handling: pass discount if applied & block sub-MOQ
    var checkoutBtn = document.getElementById('samyak-checkout-submit');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function(e) {
        if (rawCartTotal < 200000) {
          e.preventDefault();
          e.stopPropagation();
          var warn = document.getElementById('samyak-cart-moq-warning');
          if (warn) {
            warn.scrollIntoView({ behavior: 'smooth', block: 'center' });
            warn.classList.add('is-shaking');
            setTimeout(function() { warn.classList.remove('is-shaking'); }, 600);
          }
          return false;
        }

        if (activeCouponCode) {
          // If a coupon is active, navigate directly to checkout with discount parameter
          e.preventDefault();
          window.location.href = '/checkout?discount=' + encodeURIComponent(activeCouponCode);
        }
      });
    }

    updateSummaryDisplay();
  })();
</script>

