{% doc %}
  Header Actions Component (Samyak Hair Accessories)
  Renders action icons in exact order:
  1. Shopping Bag icon
  2. Wishlist Heart icon
  3. User Account profile icon
  Icons: 19px outline icons, 1.4px stroke width, color #181A19, gap 18px.
{% enddoc %}

<div class="samyak-hdr-actions-wrap" data-testid="header-actions">
  <!-- 1. Shopping Bag icon -->
  <a
    href="{{ routes.cart_url }}"
    class="samyak-hdr-action-btn samyak-hdr-cart-btn"
    aria-label="{{ 'accessibility.cart' | t }}"
    title="Shopping Cart"
    {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
      on:click="#cart-drawer/toggle"
      onclick="var d=document.getElementById('cart-drawer');if(d&&typeof d.open==='function'){event.preventDefault();d.open();}"
    {% endif %}
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#181A19" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 8h12l1 12H5L6 8Z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    </svg>
    {% if cart.item_count > 0 %}
      <span class="samyak-hdr-cart-badge" aria-hidden="true">{{ cart.item_count }}</span>
    {% endif %}
  </a>

  <!-- 2. Wishlist Heart icon -->
  <a
    href="/pages/wishlist"
    class="samyak-hdr-action-btn samyak-hdr-wishlist-btn"
    aria-label="Wishlist"
    title="My Wishlist"
    onclick="if(window.openWishlistDrawer){event.preventDefault();window.openWishlistDrawer();}"
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#181A19" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21s-7-4.6-7-9.4A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 3.6C19 16.4 12 21 12 21Z"/>
    </svg>
    <span class="samyak-hdr-cart-badge samyak-hdr-wishlist-badge" id="samyak-header-wishlist-count" style="display: none;" aria-hidden="true">0</span>
  </a>

  <!-- 3. User Account profile icon -->
  <a
    href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url | default: '/account/login' }}{% endif %}"
    class="samyak-hdr-action-btn samyak-hdr-account-btn"
    aria-label="{% if customer %}My Account{% else %}Login / Register{% endif %}"
    title="{% if customer %}My Account{% else %}Sign In / Wholesale Account{% endif %}"
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#181A19" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8" r="4"/>
      <path d="M4.5 20c1.2-4 4-6 7.5-6s6.3 2 7.5 6"/>
    </svg>
  </a>

  <!-- 4. Instagram icon -->
  <a
    href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/samyak_hair_accessories/' }}"
    target="_blank"
    rel="noopener noreferrer"
    class="samyak-hdr-action-btn samyak-hdr-instagram-btn"
    aria-label="Follow us on Instagram"
    title="Follow us on Instagram"
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#181A19" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
    </svg>
  </a>
</div>

<style>
  .samyak-hdr-actions-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }

  .samyak-hdr-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #181A19;
    position: relative;
    text-decoration: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .samyak-hdr-action-btn:hover {
    opacity: 0.75;
    transform: translateY(-1px);
  }

  .samyak-hdr-cart-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background-color: #163A28;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    min-width: 16px;
    height: 16px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    .samyak-hdr-actions-wrap {
      gap: 10px;
    }

    .samyak-hdr-instagram-btn,
    .samyak-hdr-cart-btn,
    .samyak-hdr-wishlist-btn {
      display: none !important;
    }

    .samyak-hdr-account-btn {
      display: inline-flex !important;
    }

    .samyak-hdr-action-btn svg {
      width: 22px;
      height: 22px;
    }
  }
</style>
