{% doc %}
  Renders the brand story & wholesale sourcing authority section for Samyak Hair Accessories wholesale homepage.
{% enddoc %}

<div class="samyak-story-section">
  <div class="samyak-story-container">
    <div class="samyak-story-card">
      <div class="samyak-story-content">
        <span class="samyak-section-eyebrow" style="color: #9E825C;">DIRECT SOURCING FROM FACTORY TO STORE</span>
        <h2 class="samyak-story-title">Why Thousands of Retailers Across India Choose Samyak</h2>
        <p class="samyak-story-lead">
          Headquartered in New Delhi with direct ties to premier export hubs in China and Korea, Samyak Hair Accessories bridges international beauty trends with Indian retail commerce.
        </p>
        <p class="samyak-story-body">
          Traditional retail procurement requires exhausting trips to Sadar Bazar, high travel overheads, and inconsistent lot quality. Samyak eliminates friction by providing transparent catalog rates, strict 3-stage piece inspection before dispatch, and reliable doorstep courier delivery to every pin code in India.
        </p>
        <div class="samyak-story-features">
          <div class="samyak-story-feature-item">
            <strong>3-Stage QC Inspection:</strong> Every claw spring and embellishment is inspected before carton sealing.
          </div>
          <div class="samyak-story-feature-item">
            <strong>Dedicated Account Manager:</strong> Real human wholesale assistance via WhatsApp and Phone on every order.
          </div>
        </div>
        <div class="samyak-story-cta">
          <a href="https://wa.me/919667844434?text=Hi%20Samyak%2C%20I%20have%20a%20wholesale%20query." target="_blank" rel="noopener noreferrer" class="button button--primary samyak-story-btn">
            <span>Connect with Wholesale Manager</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .samyak-story-section {
    width: 100%;
    padding-block: clamp(40px, 6vw, 76px);
    background: #FAF8F3;
  }

  .samyak-story-container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .samyak-story-card {
    background: #FCFBF7;
    border: 1px solid #E4E0D6;
    border-radius: 16px;
    padding: clamp(28px, 5vw, 56px);
    box-shadow: 0 8px 30px rgba(24, 26, 25, 0.03);
  }

  .samyak-story-content {
    max-width: 860px;
  }

  .samyak-story-title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    color: #181A19;
    line-height: 1.2;
    margin: 12px 0 18px;
    letter-spacing: -0.01em;
  }

  .samyak-story-lead {
    font-size: clamp(15px, 2vw, 17px);
    font-weight: 500;
    color: #181A19;
    line-height: 1.55;
    margin: 0 0 14px;
  }

  .samyak-story-body {
    font-size: clamp(13px, 1.8vw, 15px);
    color: #5C615E;
    line-height: 1.6;
    margin: 0 0 24px;
  }

  .samyak-story-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }

  .samyak-story-feature-item {
    font-size: 13px;
    color: #181A19;
    background: #FAF8F3;
    padding: 14px 18px;
    border-radius: 8px;
    border: 1px solid #E4E0D6;
    line-height: 1.45;
  }

  .samyak-story-feature-item strong {
    color: #113B32;
    display: block;
    margin-bottom: 2px;
  }

  .samyak-story-btn {
    background: #113B32 !important;
    color: #FCFBF7 !important;
    border: 1px solid #113B32 !important;
    padding: 14px 28px !important;
    border-radius: 999px !important;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif) !important;
    font-weight: 700 !important;
    font-size: 11px !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    text-decoration: none !important;
    transition: background 0.2s ease, transform 0.2s ease !important;
  }

  .samyak-story-btn:hover {
    background: #0B2922 !important;
    border-color: #0B2922 !important;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .samyak-story-features {
      grid-template-columns: 1fr;
    }
  }
</style>
