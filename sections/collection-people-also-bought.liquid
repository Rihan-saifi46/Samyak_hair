{% doc %}
  Renders the "People Also Bought" recommendation section on Best Seller and New Arrival collection pages.
  Follows the exact card styling, responsive grid, and brand aesthetic of Samyak Hair Accessories.
{% enddoc %}

{% liquid
  assign is_target = true
%}

{% if is_target %}
  {% render 'product-card-styles' %}
  {% render 'price-styles' %}

  <div class="samyak-pab-section" aria-labelledby="people-also-bought-title">
    <div class="samyak-pab-container">
      <div class="samyak-section-golden-heading" style="margin-bottom: 28px;">
        <span class="samyak-golden-line"></span>
        <h2 class="samyak-golden-title" id="people-also-bought-title">People Also Bought</h2>
        <span class="samyak-golden-line"></span>
      </div>

      {% liquid
        assign current_ids = collection.products | map: 'id'
        assign count = 0
        assign limit = section.settings.products_to_show | default: 4
      %}

      <ul class="samyak-pab-grid" role="list">
        {% for prod in collections['all'].products %}
          {% unless current_ids contains prod.id %}
            {% if prod.available %}
              <li class="samyak-pab-item">
                <article class="product-card">
                  <div class="product-card__content product-grid__card">
                    <div class="card-gallery">
                      <a href="{{ prod.url }}" class="product-media-container" aria-label="{{ prod.title | escape }}">
                        {% if prod.featured_media %}
                          <img
                            src="{{ prod.featured_media | image_url: width: 600 }}"
                            alt="{{ prod.featured_media.alt | default: prod.title | escape }}"
                            loading="lazy"
                            width="{{ prod.featured_media.width }}"
                            height="{{ prod.featured_media.height }}"
                            class="product-media__image"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'product-media__image' }}
                        {% endif %}
                      </a>
                    </div>
                    <div class="product-info-wrap">
                      <h3 class="product-title">
                        <a href="{{ prod.url }}">{{ prod.title | escape }}</a>
                      </h3>
                      <div class="price">
                        <span class="price-item price-item--regular">
                          {{ prod.price | money }}
                        </span>
                        {% if prod.compare_at_price > prod.price %}
                          <s class="price-item price-item--compare-at">
                            {{ prod.compare_at_price | money }}
                          </s>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </article>
              </li>
              {% assign count = count | plus: 1 %}
              {% if count >= limit %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endunless %}
        {% endfor %}

        {% comment %} Fallback: if fewer than limit products were found outside the collection, supplement from available catalog products {% endcomment %}
        {% if count < limit %}
          {% for prod in collections['all'].products limit: 12 %}
            {% if prod.available %}
              <li class="samyak-pab-item">
                <article class="product-card">
                  <div class="product-card__content product-grid__card">
                    <div class="card-gallery">
                      <a href="{{ prod.url }}" class="product-media-container" aria-label="{{ prod.title | escape }}">
                        {% if prod.featured_media %}
                          <img
                            src="{{ prod.featured_media | image_url: width: 600 }}"
                            alt="{{ prod.featured_media.alt | default: prod.title | escape }}"
                            loading="lazy"
                            width="{{ prod.featured_media.width }}"
                            height="{{ prod.featured_media.height }}"
                            class="product-media__image"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'product-media__image' }}
                        {% endif %}
                      </a>
                    </div>
                    <div class="product-info-wrap">
                      <h3 class="product-title">
                        <a href="{{ prod.url }}">{{ prod.title | escape }}</a>
                      </h3>
                      <div class="price">
                        <span class="price-item price-item--regular">
                          {{ prod.price | money }}
                        </span>
                      </div>
                    </div>
                  </div>
                </article>
              </li>
              {% assign count = count | plus: 1 %}
              {% if count >= limit %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>

  <style>
    .samyak-pab-section {
      width: 100%;
      padding-block: 48px 36px;
      background: #FFFFFF;
      border-top: 1px solid #ECE8E1;
    }
    .samyak-pab-container {
      max-width: var(--page-width, 1360px);
      margin: 0 auto;
      padding-inline: var(--page-margin, clamp(16px, 3.5vw, 40px));
      box-sizing: border-box;
      width: 100%;
    }
    .samyak-pab-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px 16px;
      margin: 0;
      padding: 0;
      list-style: none;
      justify-content: center;
    }
    @media (max-width: 1023px) {
      .samyak-pab-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px 16px;
      }
    }
    @media (max-width: 767px) {
      .samyak-pab-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px 12px;
      }

      /* Scoped Mobile Card Scaling: Eliminate double padding & skyscraper height */
      .samyak-pab-section .product-card {
        min-height: auto !important;
        height: 100% !important;
      }
      .samyak-pab-section .product-card .card-gallery {
        min-height: 190px !important;
        max-height: 230px !important;
        height: auto !important;
        aspect-ratio: 1 / 1.15 !important;
      }
      .samyak-pab-section .product-card .product-info-wrap {
        min-height: auto !important;
        height: auto !important;
        padding: 12px 10px !important;
      }
      .samyak-pab-section .product-card .product-title,
      .samyak-pab-section .product-card .price {
        padding: 0 !important;
        margin-top: 4px !important;
        width: 100% !important;
      }
      .samyak-pab-section .product-card .product-title a {
        font-size: 13.5px !important;
        line-height: 1.25 !important;
      }
      .samyak-pab-section .product-card .price .price-item {
        font-size: 14px !important;
      }
    }
    .samyak-pab-item {
      height: 100%;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "People Also Bought",
  "settings": [
    {
      "type": "checkbox",
      "id": "always_show",
      "label": "Show on all collections",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "People Also Bought"
    }
  ]
}
{% endschema %}
