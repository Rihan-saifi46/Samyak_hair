{% doc %}
  Renders the dedicated Wholesale Wishlist page for Samyak Hair Accessories.
  Connects to localStorage key 'samyak_wishlist' and dynamically displays saved products.
{% enddoc %}

<div class="samyak-wishlist-page-wrap">
  <div class="samyak-wishlist-container">
    <!-- Breadcrumb -->
    <nav class="samyak-wishlist-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="samyak-crumb-sep">/</span>
      <span class="samyak-crumb-current">Wishlist</span>
    </nav>

    <!-- Page Header -->
    <div class="samyak-wishlist-header">
      <div class="samyak-wishlist-header-left">
        <h1 class="samyak-wishlist-title">My Wholesale Wishlist</h1>
        <p class="samyak-wishlist-subtitle">
          Saved inventory selections for your store replenishment.
        </p>
      </div>
      <div class="samyak-wishlist-header-right">
        <span class="samyak-wishlist-count-badge" id="samyak-wishlist-count-badge">0 items</span>
      </div>
    </div>

    <!-- Active Wishlist Grid -->
    <div class="samyak-wishlist-grid" id="samyak-wishlist-grid" aria-live="polite">
      <!-- Loading Skeleton State -->
      <div class="samyak-wishlist-loading" id="samyak-wishlist-loading">
        <div class="samyak-skeleton-card"></div>
        <div class="samyak-skeleton-card"></div>
        <div class="samyak-skeleton-card"></div>
        <div class="samyak-skeleton-card"></div>
      </div>
    </div>

    <!-- Empty Wishlist State -->
    <div class="samyak-wishlist-empty" id="samyak-wishlist-empty" style="display: none;">
      <div class="samyak-wishlist-empty-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C59B42" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </div>
      <h2 class="samyak-wishlist-empty-title">Your Wishlist is Empty</h2>
      <p class="samyak-wishlist-empty-desc">
        You haven't saved any wholesale hair accessories yet. Browse our catalog of Korean claws, metal clips, and bulk packs to curate your inventory.
      </p>
      <a href="{{ routes.all_products_collection_url }}" class="samyak-wishlist-browse-btn">
        EXPLORE WHOLESALE CATALOG &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .samyak-wishlist-page-wrap {
    background-color: #FAF8F2;
    min-height: 70vh;
    padding: 32px 20px 80px;
    box-sizing: border-box;
  }

  .samyak-wishlist-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .samyak-wishlist-breadcrumb {
    font-size: 11.5px;
    color: #7A7F7C;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .samyak-wishlist-breadcrumb a {
    color: #5C615E;
    text-decoration: none;
    transition: color 0.15s;
  }

  .samyak-wishlist-breadcrumb a:hover {
    color: #113B32;
  }

  .samyak-crumb-sep {
    color: #C9C4BC;
  }

  .samyak-crumb-current {
    color: #113B32;
    font-weight: 600;
  }

  /* Header */
  .samyak-wishlist-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid #E4E0D6;
    margin-bottom: 32px;
  }

  .samyak-wishlist-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 34px;
    font-weight: 500;
    color: #113B32;
    margin: 0 0 6px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .samyak-wishlist-subtitle {
    font-size: 13px;
    color: #5C615E;
    margin: 0;
  }

  .samyak-wishlist-count-badge {
    background: #EFECE4;
    color: #113B32;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
  }

  /* Grid Layout */
  .samyak-wishlist-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 1024px) {
    .samyak-wishlist-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }

  @media screen and (max-width: 768px) {
    .samyak-wishlist-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .samyak-wishlist-title {
      font-size: 26px;
    }
    .samyak-wishlist-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }

  /* Card */
  .samyak-wcard {
    background: #FCFBF7;
    border: 1px solid #E8E5DC;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.25s ease;
    position: relative;
  }

  .samyak-wcard:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
  }

  .samyak-wcard-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #F2EFE8;
    overflow: hidden;
  }

  .samyak-wcard-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .samyak-wcard:hover .samyak-wcard-img-wrap img {
    transform: scale(1.04);
  }

  .samyak-wcard-remove-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    transition: background 0.15s, transform 0.15s;
    z-index: 5;
  }

  .samyak-wcard-remove-btn:hover {
    background: #FFF5F5;
    transform: scale(1.1);
  }

  .samyak-wcard-remove-btn svg {
    fill: #C53030;
    stroke: #C53030;
  }

  .samyak-wcard-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .samyak-wcard-title {
    font-size: 13px;
    font-weight: 600;
    color: #181A19;
    margin: 0 0 6px;
    line-height: 1.35;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .samyak-wcard-title:hover {
    color: #113B32;
  }

  .samyak-wcard-price {
    font-size: 14px;
    font-weight: 700;
    color: #113B32;
    margin-bottom: 12px;
  }

  .samyak-wcard-unit {
    font-size: 11px;
    font-weight: 400;
    color: #5C615E;
    margin-left: 2px;
  }

  .samyak-wcard-btn-wrap {
    margin-top: auto;
  }

  .samyak-wcard-atc-btn {
    width: 100%;
    background: #113B32;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .samyak-wcard-atc-btn:hover {
    background: #1A5447;
  }

  .samyak-wcard-atc-btn:disabled {
    background: #C9C4BC;
    cursor: not-allowed;
  }

  /* Empty State */
  .samyak-wishlist-empty {
    text-align: center;
    padding: 60px 20px;
    max-width: 520px;
    margin: 40px auto;
    background: #FCFBF7;
    border: 1px solid #E8E5DC;
    border-radius: 8px;
  }

  .samyak-wishlist-empty-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #FAF8F2;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    border: 1px solid #EFECE4;
  }

  .samyak-wishlist-empty-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 28px;
    color: #113B32;
    margin: 0 0 10px;
  }

  .samyak-wishlist-empty-desc {
    font-size: 13px;
    color: #5C615E;
    line-height: 1.5;
    margin: 0 0 24px;
  }

  .samyak-wishlist-browse-btn {
    display: inline-block;
    background: #C59B42;
    color: #FFFFFF;
    padding: 12px 24px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }

  .samyak-wishlist-browse-btn:hover {
    background: #B08834;
  }

  /* Skeletons */
  .samyak-wishlist-loading {
    display: contents;
  }

  .samyak-skeleton-card {
    height: 320px;
    background: #EFECE4;
    border-radius: 6px;
    animation: samyakShimmer 1.5s infinite linear;
  }

  @keyframes samyakShimmer {
    0% { opacity: 0.6; }
    50% { opacity: 0.3; }
    100% { opacity: 0.6; }
  }
</style>

<script>
  (function() {
    var STORAGE_KEY = 'samyak_wishlist';

    function getWishlist() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        var parsed = JSON.parse(raw || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function saveWishlist(items) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch (e) {}
    }

    function renderWishlist() {
      var grid = document.getElementById('samyak-wishlist-grid');
      var emptyEl = document.getElementById('samyak-wishlist-empty');
      var badge = document.getElementById('samyak-wishlist-count-badge');
      if (!grid || !emptyEl) return;

      var rawItems = getWishlist();

      // Deduplicate items
      var seen = {};
      var items = [];
      rawItems.forEach(function(it) {
        var id = typeof it === 'object' && it !== null ? (it.id || it.handle) : String(it);
        if (id && !seen[id]) {
          seen[id] = true;
          items.push(it);
        }
      });

      if (badge) {
        badge.textContent = items.length + (items.length === 1 ? ' item' : ' items');
      }

      if (items.length === 0) {
        grid.style.display = 'none';
        emptyEl.style.display = 'block';
        return;
      }

      grid.style.display = 'grid';
      emptyEl.style.display = 'none';
      grid.innerHTML = '';

      items.forEach(function(item) {
        var card = document.createElement('div');
        card.className = 'samyak-wcard';

        var id = typeof item === 'object' && item !== null ? item.id : String(item);
        var title = typeof item === 'object' && item !== null ? item.title : ('Product #' + id);
        var price = typeof item === 'object' && item !== null ? (item.price || '₹299.00') : 'Wholesale Pack';
        var imgUrl = typeof item === 'object' && item !== null ? (item.image || '') : '';
        var productUrl = typeof item === 'object' && item !== null ? (item.url || ('/products/' + (item.handle || ''))) : '#';

        card.setAttribute('data-item-id', id);

        card.innerHTML = [
          '<div class="samyak-wcard-img-wrap">',
            imgUrl ? '<img src="' + imgUrl + '" alt="' + title.replace(/"/g, '&quot;') + '" loading="lazy">' : '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#8C887B;font-size:12px;">Wholesale Selection</div>',
            '<button type="button" class="samyak-wcard-remove-btn" title="Remove from wishlist" aria-label="Remove ' + title.replace(/"/g, '&quot;') + ' from wishlist">',
              '<svg width="15" height="15" viewBox="0 0 24 24" fill="#C53030" stroke="#C53030" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>',
            '</button>',
          '</div>',
          '<div class="samyak-wcard-body">',
            '<a href="' + productUrl + '" class="samyak-wcard-title">' + title + '</a>',
            '<div class="samyak-wcard-price">' + price + ' <span class="samyak-wcard-unit">/ Pack</span></div>',
            '<div class="samyak-wcard-btn-wrap">',
              '<button type="button" class="samyak-wcard-atc-btn" data-add-id="' + id + '">ADD TO BAG</button>',
            '</div>',
          '</div>'
        ].join('');

        // Remove listener
        var removeBtn = card.querySelector('.samyak-wcard-remove-btn');
        if (removeBtn) {
          removeBtn.addEventListener('click', function(e) {
            e.preventDefault();
            var current = getWishlist();
            var filtered = current.filter(function(x) {
              var xId = typeof x === 'object' && x !== null ? (x.id || x.handle) : String(x);
              return String(xId) !== String(id);
            });
            saveWishlist(filtered);

            card.style.opacity = '0';
            card.style.transform = 'scale(0.9)';
            setTimeout(function() {
              renderWishlist();
              document.dispatchEvent(new CustomEvent('wishlist:updated', { bubbles: true }));
            }, 200);
          });
        }

        // Add to Bag listener
        var atcBtn = card.querySelector('.samyak-wcard-atc-btn');
        if (atcBtn) {
          atcBtn.addEventListener('click', function(e) {
            e.preventDefault();
            atcBtn.disabled = true;
            var origText = atcBtn.textContent;
            atcBtn.textContent = 'ADDING...';

            var formData = new FormData();
            formData.append('id', id);
            formData.append('quantity', 1);

            fetch('/cart/add.js', {
              method: 'POST',
              body: formData,
              headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              atcBtn.textContent = 'ADDED ✓';
              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));

              // Refresh cart drawer section HTML via Section Rendering API
              fetch('/cart?section_id=cart-drawer-section')
                .then(function(r) { return r.text(); })
                .then(function(html) {
                  var container = document.getElementById('shopify-section-cart-drawer-section') || document.getElementById('shopify-section-cart-drawer') || document.getElementById('cart-drawer');
                  var parser = new DOMParser();
                  var doc = parser.parseFromString(html, 'text/html');
                  var newInner = doc.querySelector('.cart-drawer__inner');
                  var curInner = container ? container.querySelector('.cart-drawer__inner') : document.querySelector('.cart-drawer__inner');
                  if (newInner && curInner) {
                    curInner.innerHTML = newInner.innerHTML;
                    curInner.className = newInner.className;
                  }
                })
                .catch(function() {});

              setTimeout(function() {
                atcBtn.textContent = origText;
                atcBtn.disabled = false;
                var drawer = document.getElementById('cart-drawer');
                if (drawer && typeof drawer.open === 'function') {
                  drawer.open();
                } else {
                  window.location.href = '/cart';
                }
              }, 400);
            })
            .catch(function(err) {
              console.error('Wishlist ATC error:', err);
              atcBtn.textContent = origText;
              atcBtn.disabled = false;
              window.location.href = productUrl;
            });
          });
        }

        grid.appendChild(card);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderWishlist);
    } else {
      renderWishlist();
    }

    window.addEventListener('wishlist:updated', renderWishlist);
  })();
</script>

{% schema %}
{
  "name": "Wholesale Wishlist",
  "settings": []
}
{% endschema %}
