{% comment %}
  Section: Main Customer Register
  Renders Shopify's official authenticated customer registration form.
  Styled to match Samyak Hair Accessories luxury boutique aesthetic.
{% endcomment %}

<div class="samyak-login-section">
  <div class="samyak-login-container">
    <div class="samyak-auth-card">
      <div class="samyak-auth-logo-wrap">
        <a href="{{ routes.root_url }}" aria-label="Samyak Hair Accessories">
          <img
            src="{{ 'samyak-logo-emerald.jpg' | asset_url }}"
            alt="SAMYAK HAIR ACCESSORIES"
            class="samyak-auth-logo-img"
            width="180"
            height="46"
            loading="eager"
          >
        </a>
      </div>
      <div class="samyak-auth-header">
        <h1 class="samyak-auth-title">Create Account</h1>
        <p class="samyak-auth-subtitle">Register for wholesale pricing, faster checkout, and order tracking</p>
      </div>

      {%- form 'create_customer', class: 'samyak-auth-form' -%}
        {%- if form.errors -%}
          <div class="samyak-auth-error" role="alert" tabindex="-1" autofocus>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <div>
              {{ form.errors | default_errors }}
            </div>
          </div>
        {%- endif -%}

        <div class="samyak-form-field">
          <label for="RegisterFirstName" class="samyak-field-label">First Name</label>
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterFirstName"
            autocomplete="given-name"
            class="samyak-field-input"
            placeholder="First Name"
            {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
          >
        </div>

        <div class="samyak-form-field">
          <label for="RegisterLastName" class="samyak-field-label">Last Name</label>
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterLastName"
            autocomplete="family-name"
            class="samyak-field-input"
            placeholder="Last Name"
            {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
          >
        </div>

        <div class="samyak-form-field">
          <label for="RegisterEmail" class="samyak-field-label">Email Address</label>
          <input
            type="email"
            name="customer[email]"
            id="RegisterEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            class="samyak-field-input"
            placeholder="e.g. boutique@domain.com"
            {% if form.email %}value="{{ form.email }}"{% endif %}
            required
          >
        </div>

        <div class="samyak-form-field">
          <label for="RegisterPassword" class="samyak-field-label">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="RegisterPassword"
            autocomplete="new-password"
            class="samyak-field-input"
            placeholder="Create a password"
            required
          >
        </div>

        <button type="submit" class="samyak-auth-submit-btn">
          Create Account
        </button>

        <div class="samyak-auth-footer">
          <p>Already have an account? <a href="{{ routes.account_login_url | default: '/account/login' }}" class="samyak-auth-link">Sign In</a></p>
          <p><a href="{{ routes.root_url }}" class="samyak-auth-link-back">&larr; Return to Store</a></p>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .samyak-login-section {
    background-color: #FAF8F5;
    padding-block: clamp(48px, 6vw, 84px);
    padding-inline: 20px;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .samyak-login-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .samyak-auth-card {
    background: #FFFFFF;
    border: 1px solid #ECE7E1;
    border-radius: 16px;
    padding: clamp(28px, 4vw, 42px) clamp(22px, 3.5vw, 36px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .samyak-auth-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 22px;
  }

  .samyak-auth-logo-wrap a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .samyak-auth-logo-wrap a:hover {
    opacity: 0.85;
  }

  .samyak-auth-logo-img {
    height: 48px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    display: block;
  }

  .samyak-auth-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .samyak-auth-title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 600;
    color: #113B32;
    margin: 0 0 10px;
    line-height: 1.25;
  }

  .samyak-auth-subtitle {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    color: #636865;
    margin: 0;
    line-height: 1.5;
  }

  .samyak-auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .samyak-form-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .samyak-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .samyak-field-label {
    font-size: 12.5px;
    font-weight: 600;
    color: #181A19;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .samyak-field-input {
    width: 100%;
    height: 46px;
    padding: 0 16px;
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
    color: #181A19;
    background: #FAF8F5;
    border: 1px solid #DFD9D1;
    border-radius: 8px;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .samyak-field-input:focus {
    border-color: #113B32;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(17, 59, 50, 0.1);
  }

  .samyak-auth-submit-btn {
    width: 100%;
    height: 48px;
    background: #113B32;
    color: #FFFFFF;
    border: none;
    border-radius: 30px;
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(17, 59, 50, 0.25);
    transition: background 0.2s ease, transform 0.2s ease;
    margin-top: 6px;
  }

  .samyak-auth-submit-btn:hover {
    background: #0B2922;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(17, 59, 50, 0.35);
  }

  .samyak-auth-error {
    background: #FDF2F2;
    border: 1px solid #F8D7DA;
    color: #B02A37;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 13px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.4;
  }

  .samyak-auth-error ul {
    margin: 0;
    padding-left: 16px;
  }

  .samyak-auth-footer {
    text-align: center;
    border-top: 1px solid #F0ECE4;
    padding-top: 18px;
    margin-top: 10px;
  }

  .samyak-auth-footer p {
    font-size: 13px;
    color: #636865;
    margin: 6px 0;
  }

  .samyak-auth-link {
    color: #113B32;
    font-weight: 600;
    text-decoration: none;
  }

  .samyak-auth-link:hover {
    text-decoration: underline;
  }

  .samyak-auth-link-back {
    color: #8C928F;
    font-size: 12px;
    text-decoration: none;
  }

  .samyak-auth-link-back:hover {
    color: #181A19;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
