{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    class="drawer cart-drawer"
    data-skip-node-update
    no-persist
  >
    <div
      class="cart-drawer__overlay"
      onclick="var d=document.getElementById('cart-drawer');if(d&&typeof d.close==='function')d.close();"
      aria-hidden="true"
    ></div>
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer drawer__inner"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="false"
    >
      <cart-drawer-component
        auto-open
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner drawer__contents{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header drawer__header">
              <button
                on:click="#cart-drawer/close"
                onclick="var d=document.getElementById('cart-drawer');if(d&&typeof d.close==='function')d.close();"
                class="theme-drawer__close-button drawer__close cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'content.cart_title' | t %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <div
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <div class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </div>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </div>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cart-drawer__content {
    display: flex !important;
    flex-direction: column !important;
    padding: 0 !important;
    background-color: var(--color-background) !important;
    flex: 1 1 auto !important;
    height: 100% !important;
    max-height: 100% !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch !important;
  }

  .cart-drawer__items {
    display: flex !important;
    flex-direction: column !important;
    padding-inline: var(--cart-drawer-padding) !important;
    overflow: visible !important;
    height: auto !important;
    min-height: auto !important;
    flex: none !important;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: static !important;
    bottom: auto !important;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: 16px !important;
    flex: none !important;
    width: 100% !important;
    box-sizing: border-box !important;
    background-color: var(--color-background);
    mask-image: none !important;
    -webkit-mask-image: none !important;

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog .cart-drawer__summary {
    position: static !important;
    mask-image: none !important;
    -webkit-mask-image: none !important;
  }

  .theme-drawer__dialog .cart-drawer__items {
    overflow: visible !important;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* ==========================================================================
     SAMYAK WHOLESALE NATIVE CART DRAWER STYLING
     High-Priority Stacking Context (z-index) & 3-Part Flexbox Scrolling Architecture
     ========================================================================== */

  /* 1. Global Stacking Context Enforcement */
  .shopify-section-group-header-group,
  #header-group,
  .header-wrapper,
  header {
    z-index: 100 !important;
  }

  .samyak-hero-section-wrap {
    position: relative !important;
    z-index: 1 !important;
  }

  .whatsapp-floating {
    z-index: 500 !important;
  }

  html,
  body,
  #MainContent,
  .shopify-section-group-header-group,
  #header-group,
  .page-wrapper,
  .page-wrapper--drawer-open {
    width: 100% !important;
    max-width: 100vw !important;
    transform: none !important;
    margin-right: 0 !important;
    padding-right: 0 !important;
    margin-inline-end: 0 !important;
  }

  /* Native dialog closed state */
  dialog:not([open]) {
    display: none !important;
  }

  /* --------------------------------------------------------------------------
     2. DEFAULT CLOSED STATE (when NOT active / NOT open)
     -------------------------------------------------------------------------- */

  cart-drawer.drawer:not(.active),
  theme-drawer#cart-drawer:not([open]):not(.active),
  .drawer:not(.active):not([open]) {
    position: fixed !important;
    inset: 0 !important;
    z-index: 99999 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  cart-drawer.drawer:not(.active) .cart-drawer__overlay,
  theme-drawer#cart-drawer:not([open]):not(.active) .cart-drawer__overlay,
  .drawer:not(.active):not([open]) .cart-drawer__overlay,
  theme-drawer#cart-drawer:not([open]):not(.active)::backdrop,
  theme-drawer#cart-drawer:not([open]):not(.active) .theme-drawer__dialog::backdrop {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 20, 18, 0.48) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0.3s ease, visibility 0.3s ease !important;
    pointer-events: none !important;
  }

  cart-drawer.drawer:not(.active) .drawer__inner,
  theme-drawer#cart-drawer:not([open]):not(.active) .drawer__inner,
  .drawer:not(.active):not([open]) .drawer__inner,
  theme-drawer#cart-drawer:not([open]):not(.active) .theme-drawer__dialog {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    width: 410px !important;
    max-width: 92vw !important;
    height: 100dvh !important;
    background: #FCFBF7 !important;
    transform: translateX(100%) !important;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  /* --------------------------------------------------------------------------
     3. OPEN / ACTIVE STATE (when .active or [open])
     -------------------------------------------------------------------------- */

  cart-drawer.drawer.active,
  theme-drawer#cart-drawer.active,
  theme-drawer#cart-drawer[open],
  .drawer.active,
  .drawer[open] {
    visibility: visible !important;
    pointer-events: auto !important;
    display: block !important;
  }

  cart-drawer.drawer.active .cart-drawer__overlay,
  theme-drawer#cart-drawer[open] .cart-drawer__overlay,
  theme-drawer#cart-drawer.active .cart-drawer__overlay,
  .drawer.active .cart-drawer__overlay,
  .drawer[open] .cart-drawer__overlay,
  theme-drawer#cart-drawer[open]::backdrop,
  theme-drawer#cart-drawer.active::backdrop,
  theme-drawer#cart-drawer[open] .theme-drawer__dialog::backdrop {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 20, 18, 0.48) !important;
    backdrop-filter: blur(2px) !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    cursor: pointer !important;
    display: block !important;
    z-index: 1 !important;
  }

  cart-drawer.drawer.active .drawer__inner,
  theme-drawer#cart-drawer[open] .drawer__inner,
  theme-drawer#cart-drawer.active .drawer__inner,
  .drawer.active .drawer__inner,
  .drawer[open] .drawer__inner,
  theme-drawer#cart-drawer[open] .theme-drawer__dialog,
  theme-drawer#cart-drawer.active .theme-drawer__dialog {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    inset-inline-end: 0 !important;
    width: 410px !important;
    max-width: 92vw !important;
    height: 100dvh !important;
    max-height: 100vh !important;
    background: #FCFBF7 !important;
    background-color: #FCFBF7 !important;
    transform: translateX(0) !important;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    pointer-events: auto !important;
    visibility: visible !important;
    z-index: 2 !important;
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.18) !important;
    border: none !important;
    border-left: 1px solid #E4E0D6 !important;
    box-sizing: border-box !important;
  }

  /* 4. Strict 3-Part Flexbox Architecture */

  /* Part 1: Top Header (Pinned Top) */
  #cart-drawer .theme-drawer__header,
  .drawer__header {
    flex: 0 0 auto !important;
    padding: 18px 22px !important;
    border-bottom: 1px solid #E4E0D6 !important;
    background: #FCFBF7 !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
    box-sizing: border-box !important;
    z-index: 10 !important;
  }

  #cart-drawer #cart-drawer-heading,
  #cart-drawer .theme-drawer__title,
  .drawer__heading {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 22px !important;
    font-weight: 500 !important;
    color: #113B32 !important;
    margin: 0 !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
  }

  #cart-drawer .theme-drawer__badge {
    background-color: #113B32 !important;
    color: #FFFFFF !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    min-width: 18px !important;
    height: 18px !important;
    border-radius: 999px !important;
    margin-inline-start: 6px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  #cart-drawer .theme-drawer__close-button,
  .drawer__close {
    color: #5C615E !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: color 0.15s, background-color 0.15s !important;
  }

  #cart-drawer .theme-drawer__close-button:hover,
  .drawer__close:hover {
    color: #181A19 !important;
    background-color: #EFECE4 !important;
  }

  #cart-drawer .theme-drawer__close-button svg,
  .drawer__close svg {
    width: 15px !important;
    height: 15px !important;
    display: block !important;
  }

  /* Part 2: Middle Scrollable Product Area */
  #cart-drawer cart-drawer-component,
  #cart-drawer .cart-items-component,
  cart-drawer-items,
  .drawer__contents {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    width: 100% !important;
  }

  #cart-drawer .cart-drawer__content {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    width: 100% !important;
    background-color: #FCFBF7 !important;
  }

  #cart-drawer .cart-drawer__items,
  .drawer__cart-items-wrapper,
  .cart-items {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    padding: 16px 22px !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  #cart-drawer .cart-items__wrapper,
  #cart-drawer .cart-form,
  #CartDrawer-Form {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
  }

  #cart-drawer .cart-items__table {
    width: 100% !important;
    border-collapse: collapse !important;
  }

  #cart-drawer .cart-items__table-row {
    display: grid !important;
    grid-template-columns: 68px 1fr !important;
    gap: 14px !important;
    padding-bottom: 16px !important;
    margin-bottom: 16px !important;
    border-bottom: 1px solid #EFECE4 !important;
    align-items: start !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  #cart-drawer .cart-items__table-row:last-child {
    border-bottom: none !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }

  #cart-drawer .cart-items__media {
    width: 68px !important;
    min-width: 68px !important;
    max-width: 68px !important;
    height: 68px !important;
    padding: 0 !important;
  }

  #cart-drawer .cart-items__media-container {
    width: 68px !important;
    height: 68px !important;
    border-radius: 6px !important;
    border: 1px solid #E4E0D6 !important;
    background: #EFECE4 !important;
    overflow: hidden !important;
    display: block !important;
  }

  #cart-drawer .cart-items__media-image {
    width: 68px !important;
    height: 68px !important;
    object-fit: cover !important;
    border-radius: 6px !important;
    border: none !important;
    display: block !important;
  }

  #cart-drawer .cart-items__details {
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
    min-width: 0 !important;
  }

  #cart-drawer .cart-items__title {
    font-size: 13.5px !important;
    font-weight: 600 !important;
    color: #113B32 !important;
    line-height: 1.3 !important;
    text-decoration: none !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
  }

  #cart-drawer .cart-items__title:hover {
    color: #C59B42 !important;
  }

  #cart-drawer .cart-items__variants dd {
    font-size: 11px !important;
    color: #5C615E !important;
    margin: 0 !important;
  }

  #cart-drawer .cart-items__unit-price-wrapper,
  #cart-drawer .cart-items__price {
    color: #113B32 !important;
    font-weight: 600 !important;
    font-size: 13.5px !important;
  }

  #cart-drawer .cart-items__quantity {
    grid-column: 2 !important;
    padding: 0 !important;
    margin-top: 6px !important;
  }

  #cart-drawer .cart-items__quantity-controls {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
    width: 100% !important;
  }

  #cart-drawer quantity-selector,
  #cart-drawer .quantity-selector {
    border: 1px solid #D5D0CA !important;
    border-radius: 4px !important;
    height: 30px !important;
    background: #FCFBF7 !important;
    display: inline-flex !important;
    align-items: center !important;
    overflow: hidden !important;
  }

  #cart-drawer .quantity-selector__button {
    width: 26px !important;
    height: 30px !important;
    background: transparent !important;
    border: none !important;
    font-size: 14px !important;
    color: #181A19 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  #cart-drawer .quantity-selector__input {
    width: 28px !important;
    height: 30px !important;
    border: none !important;
    background: transparent !important;
    text-align: center !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #181A19 !important;
    padding: 0 !important;
  }

  #cart-drawer .cart-items__remove {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    min-width: 0 !important;
    min-height: 0 !important;
    height: auto !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  #cart-drawer .cart-items__remove svg {
    display: none !important;
  }

  #cart-drawer .cart-items__remove::after {
    content: 'Remove';
    font-size: 11px !important;
    color: #7A7770 !important;
    text-decoration: underline !important;
    font-family: inherit !important;
    cursor: pointer !important;
    transition: color 0.15s !important;
  }

  #cart-drawer .cart-items__remove:hover::after {
    color: #181A19 !important;
  }

  /* Part 3: Bottom Pinned Sticky Footer */
  #cart-drawer .cart-drawer__summary,
  .drawer__footer {
    flex: 0 0 auto !important;
    padding: 14px 22px 20px !important;
    border-top: 1px solid #E4E0D6 !important;
    background: #FCFBF7 !important;
    mask-image: none !important;
    -webkit-mask-image: none !important;
    margin-top: auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    z-index: 10 !important;
  }

  #cart-drawer .cart-wholesale-bar {
    background: #FAF8F2 !important;
    border: 1px solid #E4E0D6 !important;
    border-radius: 6px !important;
    padding: 10px 14px !important;
    margin-bottom: 6px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  #cart-drawer .cart-wholesale-bar__status {
    color: #181A19 !important;
    font-size: 12px !important;
  }

  #cart-drawer .cart-wholesale-bar__status--met {
    color: #113B32 !important;
    font-weight: 600 !important;
  }

  #cart-drawer .cart-wholesale-bar__track {
    background: #EFECE4 !important;
    height: 5px !important;
    border-radius: 999px !important;
    margin-top: 6px !important;
    overflow: hidden !important;
  }

  #cart-drawer .cart-wholesale-bar__progress {
    background: #113B32 !important;
    border-radius: 999px !important;
  }

  #cart-drawer .cart-wholesale-bar__hint {
    color: #5C615E !important;
    font-size: 11px !important;
    margin-top: 4px !important;
  }

  #cart-drawer .cart-wholesale-warning {
    width: 100% !important;
