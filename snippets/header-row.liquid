{% doc %}
  Renders the 3-zone integrated header row for Samyak Hair Accessories.
  - Left Zone: Drawer trigger (mobile/tablet) + Stylized emerald & gold Brand Logo.
  - Center Zone: 2-Row Stacked Search + Navigation Links.
  - Right Zone: Action Icons (Bag, Heart, Profile).
  - Background: #F6F4EE, Padding: 16px 36px 14px.

  @param {string} [first] - The mobile menu drawer or first element
  @param {string} [logo] - The brand logo
  @param {string} [search] - The search bar and desktop navigation
  @param {string} [actions] - Action icons (bag, wishlist, profile)
  @param {string} [row] - Row identifier ('top' or 'bottom')
  @param {string} [order] - Layout column ordering
  @param {object} [settings] - Section settings object
  @param {string} [menu] - Menu block markup
  @param {string} [localization] - Localization block markup
  @param {string} [drawer_search] - Drawer search markup
{% enddoc %}

{%- liquid
  if row == 'top'
    assign show_row = true
  else
    assign show_row = false
  endif
-%}

{%- if show_row -%}
  <div class="samyak-header-3zone-bar">
    <!-- Left Zone: Drawer Trigger (Mobile Hamburger) & Desktop Logo -->
    <div class="samyak-hdr-col samyak-hdr-col--left">
      {%- if first != blank -%}
        <div class="samyak-hdr-drawer-trigger">
          {{ first }}
        </div>
      {%- endif -%}
      <div class="samyak-hdr-logo samyak-hdr-logo--desktop">
        {{ logo }}
      </div>
    </div>

    <!-- Center Zone: Mobile Centered Logo & Desktop 2-Row Stacked Search + Nav Links -->
    <div class="samyak-hdr-col samyak-hdr-col--center">
      <div class="samyak-hdr-logo samyak-hdr-logo--mobile">
        {{ logo }}
      </div>
      <div class="samyak-hdr-desktop-center">
        {{ search }}
      </div>
    </div>

    <!-- Right Zone: Action Icons -->
    <div class="samyak-hdr-col samyak-hdr-col--right">
      {{ actions }}
    </div>
  </div>

  <style>
    .header__row--top,
    .samyak-header-3zone-bar {
      background-color: #F6F4EE !important;
      width: 100%;
      box-sizing: border-box;
    }

    .samyak-header-3zone-bar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      padding: 16px 36px 14px;
      gap: 24px;
      max-width: 100%;
    }

    .samyak-hdr-col--left {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      flex-shrink: 0;
    }

    .samyak-hdr-drawer-trigger {
      display: none;
    }

    .samyak-hdr-logo--desktop {
      display: flex;
      align-items: center;
    }

    .samyak-hdr-logo--mobile {
      display: none;
    }

    .samyak-hdr-col--center {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
    }

    .samyak-hdr-desktop-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .samyak-hdr-col--right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-shrink: 0;
    }

    #header-component,
    .header-section {
      background-color: #F6F4EE !important;
      border-bottom: 1px solid rgba(200, 195, 184, 0.45);
    }

    .header__row--bottom {
      display: none !important;
    }

    @media screen and (max-width: 1024px) {
      .samyak-header-3zone-bar {
        padding: 12px 18px;
        gap: 14px;
      }
    }

    /* Mobile Phone View matching swastikjewel.in layout */
    @media screen and (max-width: 768px) {
      .samyak-header-3zone-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 14px;
        gap: 10px;
        position: relative;
        min-height: 58px;
        height: auto;
        box-sizing: border-box;
      }

      /* Left: Hamburger menu only */
      .samyak-hdr-col--left {
        width: 44px;
        flex-shrink: 0;
        justify-content: flex-start;
      }

      .samyak-hdr-drawer-trigger {
        display: flex;
        align-items: center;
      }

      .samyak-hdr-drawer-trigger .header__drawer {
        display: block;
      }

      .samyak-hdr-drawer-trigger .header__icon--summary {
        padding: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #113B32;
        border: none;
        background: transparent;
      }

      .samyak-hdr-drawer-trigger .header-drawer-icon {
        width: 24px;
        height: 24px;
        display: block;
      }

      .samyak-hdr-drawer-trigger .header-drawer-icon svg {
        width: 100%;
        height: 100%;
      }

      .samyak-hdr-logo--desktop {
        display: none !important;
      }

      /* Center: Brand Logo centered perfectly */
      .samyak-hdr-col--center {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .samyak-hdr-logo--mobile {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .samyak-hdr-logo--mobile .samyak-header-logo-img {
        height: 42px !important;
        max-height: 42px !important;
        width: auto !important;
        object-fit: contain !important;
        display: block !important;
      }

      .samyak-hdr-desktop-center {
        display: none !important;
      }

      /* Right: Action icons */
      .samyak-hdr-col--right {
        width: auto;
        flex-shrink: 0;
        justify-content: flex-end;
      }
    }
  </style>
{%- endif -%}
