{% doc %}
  Renders the interactive 3D Coverflow / Stacked Perspective Carousel ("FOR EVERY YOU") for Samyak Hair Accessories.
  Features the 5 Hair Accessory collections in a horizontal 3D perspective layout with smooth rotation and depth.
{% enddoc %}

{%- liquid
  assign heading = section.settings.heading | default: 'FOR EVERY YOU'
  assign subheading = section.settings.subheading | default: 'For every mood, moment, and milestone — there is a piece that speaks your style.'
  assign heading_color = section.settings.heading_color | default: '#113B32'
  assign subheading_color = section.settings.subheading_color | default: '#5C615E'
  assign background_color = section.settings.background_color | default: '#F7F5EE'

  assign col1 = collections['claw-clip'] | default: collections['metal-claw'] | default: collections['claw-clips']
  assign col2 = collections['headband'] | default: collections['hair-band'] | default: collections['hair-bands']
  assign col3 = collections['bows-accessories'] | default: collections['bows'] | default: collections['kids-collection']
  assign col4 = collections['hair-pin'] | default: collections['hair-pins'] | default: collections['hair-extensions']
  assign col5 = collections['scrunchie'] | default: collections['scrunchies'] | default: collections['satin-scrunchies']

  # Verified collection featured images with 5 custom jewelry/hair accessory photography assets
  assign default_img_1 = 'for-every-you-1.jpg' | asset_url
  assign default_img_2 = 'for-every-you-2.jpg' | asset_url
  assign default_img_3 = 'for-every-you-3.jpg' | asset_url
  assign default_img_4 = 'for-every-you-4.jpg' | asset_url
  assign default_img_5 = 'for-every-you-5.jpg' | asset_url

  assign default_titles = 'HAIR CLIPS / CLUTCHERS,HAIR BANDS,BOWS & ACCESSORIES,HAIR PINS & BROOCHES,SATIN SCRUNCHIES' | split: ','
  assign default_alts = 'Wholesale Pearl & Floral Hair Clips,Wholesale Braided Pearl Hair Bands,Wholesale Ribbon Bow Hair Clips,Wholesale Crystal & Pearl Hair Pins,Wholesale Luxury Satin Scrunchies' | split: ','

  assign default_imgs = default_img_1 | append: ',' | append: default_img_2 | append: ',' | append: default_img_3 | append: ',' | append: default_img_4 | append: ',' | append: default_img_5 | split: ','

  # Exact collection routes matching merchant Shopify admin handles
  assign url1 = col1.url | default: '/collections/claw-clip'
  assign url2 = col2.url | default: '/collections/headband'
  assign url3 = col3.url | default: '/collections/all'
  assign url4 = col4.url | default: '/collections/hair-pin'
  assign url5 = col5.url | default: '/collections/scrunchie'

  assign has_custom_blocks = false
  if section.blocks.size >= 5
    assign has_custom_blocks = true
  endif
-%}

<section
  class="sc-section"
  id="sc-section-{{ section.id | default: 'home' }}"
  style="--sc-bg: {{ background_color }}; --sc-heading-color: {{ heading_color }}; --sc-subheading-color: {{ subheading_color }};"
  aria-label="Collections Showcase"
>
  <div class="sc-container">
    <header class="sc-header">
      <h2 class="sc-heading" id="sc-heading-{{ section.id | default: 'home' }}">{{ heading }}</h2>
      <p class="sc-subheading">{{ subheading }}</p>
    </header>

    <div class="sc-carousel-wrapper">
      <!-- Left Navigation Control -->
      <button
        type="button"
        class="sc-nav-btn sc-nav-prev"
        aria-label="Previous Collection"
        title="Previous collection"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- 3D Perspective Stage -->
      <div
        class="sc-stage"
        role="region"
        aria-roledescription="carousel"
        aria-labelledby="sc-heading-{{ section.id | default: 'home' }}"
      >
        {%- if has_custom_blocks -%}
          {%- for block in section.blocks limit: 5 -%}
            {%- liquid
              assign idx = forloop.index0
              case idx
                when 0
                  assign offset_val = 0
                  assign default_url = url1
                when 1
                  assign offset_val = 1
                  assign default_url = url2
                when 2
                  assign offset_val = 2
                  assign default_url = url3
                when 3
                  assign offset_val = -2
                  assign default_url = url4
                when 4
                  assign offset_val = -1
                  assign default_url = url5
              endcase

              assign card_title = block.settings.title | default: block.settings.collection.title | default: default_titles[idx]
              assign card_url = block.settings.custom_link | default: block.settings.collection.url | default: default_url
              if block.settings.image != blank
                assign card_img = block.settings.image | image_url: width: 800
              elsif block.settings.collection.featured_image != blank
                assign card_img = block.settings.collection.featured_image | image_url: width: 800
              else
                assign card_img = default_imgs[idx]
              endif
              assign card_alt = block.settings.title | default: default_alts[idx]
            -%}
            <a
              href="{{ card_url }}"
              class="sc-card"
              data-index="{{ idx }}"
              data-offset="{{ offset_val }}"
              aria-label="{{ card_title | escape }}"
              {% if offset_val == 0 %}tabindex="0" aria-hidden="false"{% else %}tabindex="-1" aria-hidden="true"{% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="sc-card__media">
                <img
                  src="{{ card_img }}"
                  alt="{{ card_alt | escape }}"
                  loading="lazy"
                  class="sc-card__photo"
                  width="340"
                  height="430"
                >
              </div>
              <div class="sc-card__overlay" aria-hidden="true"></div>
              <div class="sc-card__content">
                <span class="sc-card__title">{{ card_title }}</span>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- comment %} Default 5 Collections {% endcomment -%}
          {%- for i in (0..4) -%}
            {%- liquid
              case i
                when 0
                  assign offset_val = 0
                  assign card_title = default_titles[0]
                  assign card_url = url1
                  assign card_img = default_imgs[0]
                  assign card_alt = default_alts[0]
                when 1
                  assign offset_val = 1
                  assign card_title = default_titles[1]
                  assign card_url = url2
                  assign card_img = default_imgs[1]
                  assign card_alt = default_alts[1]
                when 2
                  assign offset_val = 2
                  assign card_title = default_titles[2]
                  assign card_url = url3
                  assign card_img = default_imgs[2]
                  assign card_alt = default_alts[2]
                when 3
                  assign offset_val = -2
                  assign card_title = default_titles[3]
                  assign card_url = url4
                  assign card_img = default_imgs[3]
                  assign card_alt = default_alts[3]
                when 4
                  assign offset_val = -1
                  assign card_title = default_titles[4]
                  assign card_url = url5
                  assign card_img = default_imgs[4]
                  assign card_alt = default_alts[4]
              endcase
            -%}
            <a
              href="{{ card_url }}"
              class="sc-card"
              data-index="{{ i }}"
              data-offset="{{ offset_val }}"
              aria-label="{{ card_title | escape }}"
              {% if offset_val == 0 %}tabindex="0" aria-hidden="false"{% else %}tabindex="-1" aria-hidden="true"{% endif %}
            >
              <div class="sc-card__media">
                <img
                  src="{{ card_img }}"
                  alt="{{ card_alt | escape }}"
                  loading="lazy"
                  class="sc-card__photo"
                  width="340"
                  height="430"
                >
              </div>
              <div class="sc-card__overlay" aria-hidden="true"></div>
              <div class="sc-card__content">
                <span class="sc-card__title">{{ card_title }}</span>
              </div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- Right Navigation Control -->
      <button
        type="button"
        class="sc-nav-btn sc-nav-next"
        aria-label="Next Collection"
        title="Next collection"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     3D STACKED PERSPECTIVE CAROUSEL / COVERFLOW (.sc-*)
     ========================================================================== */
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap');

  .sc-section {
    background-color: var(--sc-bg, #FFFFFF);
    padding: 80px 40px;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .sc-container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .sc-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .sc-heading {
    font-family: 'Playfair Display', 'Cormorant Garamond', 'Bodoni Moda', Georgia, serif;
    font-size: 34px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--sc-heading-color, #113B32);
    margin: 0 0 14px;
    line-height: 1.2;
  }

  .sc-subheading {
    font-family: var(--font-body--family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--sc-subheading-color, #666666);
    max-width: 480px;
    margin: 0 auto;
  }

  .sc-carousel-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 480px;
  }

  .sc-stage {
    position: relative;
    width: 100%;
    height: 460px;
    perspective: 1200px;
    perspective-origin: center center;
    transform-style: preserve-3d;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sc-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 340px;
    height: 430px;
    margin-left: -170px;
    margin-top: -215px;
    border-radius: 2px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    transform-origin: center center;
    transform-style: preserve-3d;
    will-change: transform, opacity, box-shadow;
    transition: transform 0.55s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.55s cubic-bezier(0.25, 1, 0.5, 1),
                box-shadow 0.55s cubic-bezier(0.25, 1, 0.5, 1);
    user-select: none;
    -webkit-user-drag: none;
    background-color: #1a1a1a;
  }

  /* Card Visual Hierarchy & 3D Depth Positioning */

  /* Center Active Card (index === activeIndex) */
  .sc-card[data-offset="0"] {
    transform: translateX(0px) scale(1) rotateY(0deg);
    z-index: 30;
    opacity: 1;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    pointer-events: auto;
  }

  /* Immediate Adjacent Left Card (-1) */
  .sc-card[data-offset="-1"] {
    transform: translateX(-240px) scale(0.86) rotateY(14deg);
    z-index: 20;
    opacity: 0.92;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.10);
    cursor: pointer;
    pointer-events: auto;
  }

  /* Immediate Adjacent Right Card (+1) */
  .sc-card[data-offset="1"] {
    transform: translateX(240px) scale(0.86) rotateY(-14deg);
    z-index: 20;
    opacity: 0.92;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.10);
    cursor: pointer;
    pointer-events: auto;
  }

  /* Outer Edge Far Left Card (-2) */
  .sc-card[data-offset="-2"] {
    transform: translateX(-430px) scale(0.72) rotateY(22deg);
    z-index: 10;
    opacity: 0.45;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    cursor: pointer;
    pointer-events: auto;
  }

  /* Outer Edge Far Right Card (+2) */
  .sc-card[data-offset="2"] {
    transform: translateX(430px) scale(0.72) rotateY(-22deg);
    z-index: 10;
    opacity: 0.45;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    cursor: pointer;
    pointer-events: auto;
  }

  /* Hidden fallback for any extra cards */
  .sc-card[data-offset="99"],
  .sc-card:not([data-offset="0"]):not([data-offset="1"]):not([data-offset="-1"]):not([data-offset="2"]):not([data-offset="-2"]) {
    transform: translateX(0px) scale(0.6) rotateY(0deg);
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  /* Card Image */
  .sc-card__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .sc-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sc-card[data-offset="0"]:hover .sc-card__photo {
    transform: scale(1.04);
  }

  /* Dark Gradient Vignette */
  .sc-card__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, transparent 45%);
  }

  /* Category Title Label */
  .sc-card__content {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    z-index: 3;
    text-align: center;
    pointer-events: none;
    padding: 0 16px;
  }

  .sc-card__title {
    display: inline-block;
    font-family: var(--font-body--family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #FFFFFF;
    border-bottom: 1px solid rgba(255, 255, 255, 0.85);
    padding-bottom: 4px;
    transition: border-color 0.3s ease, letter-spacing 0.3s ease;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .sc-card[data-offset="0"]:hover .sc-card__title {
    border-color: #FFFFFF;
    letter-spacing: 2px;
  }

  /* Floating Circular Navigation Controls */
  .sc-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: #FFFFFF;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1A1A1A;
    cursor: pointer;
    z-index: 50;
    padding: 0;
    transition: transform 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, background 0.25s ease;
  }

  .sc-nav-btn:hover {
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
    color: var(--sc-heading-color, #113B32);
  }

  .sc-nav-btn:active {
    transform: translateY(-50%) scale(0.96);
  }

  .sc-nav-btn:focus-visible {
    outline: 2px solid var(--sc-heading-color, #113B32);
    outline-offset: 2px;
  }

  .sc-nav-prev {
    left: 32px;
  }

  .sc-nav-next {
    right: 32px;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 1024px) {
    .sc-card[data-offset="-2"] {
      transform: translateX(-360px) scale(0.72) rotateY(20deg);
    }
    .sc-card[data-offset="2"] {
      transform: translateX(360px) scale(0.72) rotateY(-20deg);
    }
    .sc-card[data-offset="-1"] {
      transform: translateX(-200px) scale(0.86) rotateY(12deg);
    }
    .sc-card[data-offset="1"] {
      transform: translateX(200px) scale(0.86) rotateY(-12deg);
    }
    .sc-nav-prev {
      left: 16px;
    }
    .sc-nav-next {
      right: 16px;
    }
  }

  @media (max-width: 768px) {
    .sc-section {
      padding: 44px 12px 36px;
      overflow: hidden;
    }

    .sc-header {
      margin-bottom: 24px;
    }

    .sc-heading {
      font-size: 26px;
      letter-spacing: 1.5px;
      margin-bottom: 8px;
    }

    .sc-subheading {
      font-size: 13.5px;
      max-width: 380px;
      padding: 0 10px;
      line-height: 1.5;
    }

    .sc-carousel-wrapper {
      min-height: 380px;
      margin-top: 16px;
      position: relative;
      width: 100%;
      overflow: visible;
    }

    .sc-stage {
      height: 360px;
      perspective: 1000px;
      perspective-origin: center center;
    }

    .sc-card {
      width: 265px;
      height: 330px;
      margin-left: -132.5px;
      margin-top: -165px;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    /* Active Center Card */
    .sc-card[data-offset="0"] {
      transform: translateX(0px) scale(1.05) rotateY(0deg);
      z-index: 100;
      opacity: 1;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
    }

    /* Immediate Adjacent Left Card (-1) */
    .sc-card[data-offset="-1"] {
      transform: translateX(-160px) scale(0.85) rotateY(24deg);
      z-index: 90;
      opacity: 0.8;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
    }

    /* Immediate Adjacent Right Card (+1) */
    .sc-card[data-offset="1"] {
      transform: translateX(160px) scale(0.85) rotateY(-24deg);
      z-index: 90;
      opacity: 0.8;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
    }

    /* Far Left Card (-2) */
    .sc-card[data-offset="-2"] {
      transform: translateX(-270px) scale(0.70) rotateY(38deg);
      z-index: 80;
      opacity: 0.4;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    }

    /* Far Right Card (+2) */
    .sc-card[data-offset="2"] {
      transform: translateX(270px) scale(0.70) rotateY(-38deg);
      z-index: 80;
      opacity: 0.4;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    }

    .sc-card__title {
      font-size: 12.5px;
      letter-spacing: 1.2px;
    }

    .sc-nav-btn {
      width: 40px;
      height: 40px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }

    .sc-nav-prev {
      left: 6px;
    }

    .sc-nav-next {
      right: 6px;
    }
  }

  @media (max-width: 440px) {
    .sc-card {
      width: 245px;
      height: 310px;
      margin-left: -122.5px;
      margin-top: -155px;
      border-radius: 16px;
    }

    .sc-stage {
      height: 335px;
    }

    .sc-card[data-offset="-1"] {
      transform: translateX(-145px) scale(0.85) rotateY(24deg);
    }

    .sc-card[data-offset="1"] {
      transform: translateX(145px) scale(0.85) rotateY(-24deg);
    }

    .sc-card[data-offset="-2"] {
      transform: translateX(-240px) scale(0.70) rotateY(38deg);
    }

    .sc-card[data-offset="2"] {
      transform: translateX(240px) scale(0.70) rotateY(-38deg);
    }

    .sc-nav-btn {
      width: 36px;
      height: 36px;
    }

    .sc-nav-prev {
      left: 4px;
    }

    .sc-nav-next {
      right: 4px;
    }
  }
</style>

<script>
  (function() {
    function initSamyakCoverflow(container) {
      if (!container || container.getAttribute('data-sc-initialized') === 'true') return;
      container.setAttribute('data-sc-initialized', 'true');

      var cards = Array.from(container.querySelectorAll('.sc-card'));
      var prevBtn = container.querySelector('.sc-nav-prev');
      var nextBtn = container.querySelector('.sc-nav-next');
      var stage = container.querySelector('.sc-stage');
      var total = cards.length;
      if (total === 0) return;

      var activeIndex = 0; // Hair Clips / Clutchers is center card (index 0) by default
      var isSwiping = false;

      function updateCards() {
        cards.forEach(function(card, i) {
          // Calculate modular offset in [-2, 2]
          var diff = (i - activeIndex + total) % total;
          var offset = diff > 2 ? diff - total : diff;
          card.setAttribute('data-offset', offset);

          if (offset === 0) {
            card.setAttribute('aria-hidden', 'false');
            card.setAttribute('tabindex', '0');
          } else {
            card.setAttribute('aria-hidden', 'true');
            card.setAttribute('tabindex', '-1');
          }
        });
      }

      function setActive(idx) {
        activeIndex = ((idx % total) + total) % total;
        updateCards();
      }

      function next() {
        setActive(activeIndex + 1);
      }

      function prev() {
        setActive(activeIndex - 1);
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          next();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          prev();
        });
      }

      // Card Click Behavior:
      // Clicking ANY card navigates directly to that collection!
      cards.forEach(function(card, idx) {
        card.addEventListener('click', function(e) {
          if (isSwiping) {
            e.preventDefault();
            return;
          }
          var url = card.getAttribute('href');
          if (url && url !== '#' && url !== 'javascript:void(0)') {
            window.location.href = url;
          }
        });
      });

      // Keyboard navigation
      container.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') {
          prev();
        } else if (e.key === 'ArrowRight') {
          next();
        }
      });

      // Touch Swipe Support
      if (stage) {
        var touchStartX = 0;
        var touchStartY = 0;
        var touchEndX = 0;
        var touchEndY = 0;
        var swipeDistance = 0;

        stage.addEventListener('touchstart', function(e) {
          if (e.touches.length === 1) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
            isSwiping = false;
          }
        }, { passive: true });

        stage.addEventListener('touchmove', function(e) {
          if (e.touches.length === 1) {
            var currentX = e.touches[0].clientX;
            var currentY = e.touches[0].clientY;
            var deltaX = currentX - touchStartX;
            var deltaY = currentY - touchStartY;
            if (Math.abs(deltaX) > 10 && Math.abs(deltaX) > Math.abs(deltaY)) {
              isSwiping = true;
            }
          }
        }, { passive: true });

        stage.addEventListener('touchend', function(e) {
          if (e.changedTouches.length === 1) {
            touchEndX = e.changedTouches[0].clientX;
            touchEndY = e.changedTouches[0].clientY;
            var diffX = touchEndX - touchStartX;
            var diffY = touchEndY - touchStartY;

            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
              if (diffX < 0) {
                next();
              } else {
                prev();
              }
            }

            // Reset isSwiping after short delay to allow clicks to register
            setTimeout(function() {
              isSwiping = false;
            }, 60);
          }
        }, { passive: true });
      }

      // Initial card position setup
      updateCards();
    }

    function initAll() {
      document.querySelectorAll('.sc-section').forEach(initSamyakCoverflow);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    // Support Shopify Theme Customizer section events
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target) {
        var sec = e.target.querySelector('.sc-section') || (e.target.classList.contains('sc-section') ? e.target : null);
        if (sec) initSamyakCoverflow(sec);
      }
    });

    document.addEventListener('shopify:section:select', function(e) {
      if (e.target) {
        var sec = e.target.querySelector('.sc-section') || (e.target.classList.contains('sc-section') ? e.target : null);
        if (sec) initSamyakCoverflow(sec);
      }
    });
  })();
</script>
