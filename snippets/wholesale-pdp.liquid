<script>
  (function() {
    // 2. Honest Postal Zone Transit Estimator
    function initPinChecker() {
      var input = document.getElementById('samyak-pin-input');
      var btn = document.getElementById('samyak-pin-btn');
      var feedback = document.getElementById('samyak-pin-feedback');
      if (!input || !btn || !feedback) return;

      function checkPin() {
        var val = input.value.trim();
        if (!/^\d{6}$/.test(val)) {
          feedback.className = 'samyak-pin-feedback is-invalid';
          feedback.textContent = 'Please enter a valid 6-digit Indian PIN code.';
          feedback.style.display = 'block';
          return;
        }

        var firstDigit = parseInt(val.charAt(0), 10);
        // Valid Indian civilian postal zones are 1 through 8
        if (firstDigit < 1 || firstDigit > 8) {
          feedback.className = 'samyak-pin-feedback is-invalid';
          feedback.textContent = 'Please enter a valid civilian Indian postal code (starting with digits 1–8).';
          feedback.style.display = 'block';
          return;
        }

        // Zone-based transit guidance
        var zoneText = '2–4 Business Days';
        var hub = 'Central Delhi';
        if (firstDigit === 1) {
          zoneText = '1–2 Business Days (Delhi NCR / Northern Zone)';
        } else if (firstDigit === 2 || firstDigit === 3) {
          zoneText = '2–3 Business Days (North / West Commercial Hubs)';
        } else if (firstDigit === 4 || firstDigit === 5) {
          zoneText = '2–4 Business Days (Western / Southern Metro Corridors)';
        } else {
          zoneText = '3–5 Business Days (Eastern / Special Coverage Zones)';
        }

        feedback.className = 'samyak-pin-feedback is-valid';
        feedback.innerHTML = '✓ Estimated courier transit to PIN <strong>' + val + '</strong>: <strong>' + zoneText + '</strong> via Bluedart / Delhivery / DTDC.<br><small style="font-size:11px; opacity:0.85; display:block; margin-top:4px;">*Orders dispatch within 24–48 hours from ' + hub + '. Tracking link provided automatically via WhatsApp upon shipment.</small>';
        feedback.style.display = 'block';
      }

      btn.addEventListener('click', checkPin);
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          checkPin();
        }
      });
    }

    // 3. Thumbnail Gallery Switcher
    function initThumbnails() {
      var thumbs = document.querySelectorAll('.samyak-pdp-thumb');
      var mainImg = document.getElementById('samyak-pdp-main-img');
      if (!thumbs.length || !mainImg) return;

      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var fullUrl = this.getAttribute('data-full-url');
          var alt = this.getAttribute('data-alt');
          if (fullUrl) {
            mainImg.style.opacity = '0.3';
            setTimeout(function() {
              mainImg.src = fullUrl;
              if (alt) mainImg.alt = alt;
              mainImg.style.opacity = '1';
            }, 100);
          }

          thumbs.forEach(function(t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');
        });
      });
    }

    // 4. Variant Selection & Synchronization
    function initVariants() {
      var swatches = document.querySelectorAll('.samyak-pdp-swatch');
      var hiddenId = document.getElementById('samyak-pdp-variant-id');
      var priceDisplay = document.getElementById('samyak-pdp-price-display');
      var comparePrice = document.getElementById('samyak-pdp-compare-price');
      var atcBtn = document.getElementById('samyak-pdp-btn-atc');
      var atcLabel = document.getElementById('samyak-pdp-atc-label');
      var buynowBtn = document.getElementById('samyak-pdp-btn-buynow');
      var mainImg = document.getElementById('samyak-pdp-main-img');

      if (!swatches.length) return;

      swatches.forEach(function(swatch) {
        swatch.addEventListener('click', function() {
          if (this.classList.contains('is-sold-out') && !this.getAttribute('data-available')) {
            // Still allow clicking to view sold out state
          }

          swatches.forEach(function(s) {
            s.classList.remove('is-selected');
            s.setAttribute('aria-checked', 'false');
          });
          this.classList.add('is-selected');
          this.setAttribute('aria-checked', 'true');

          var variantId = this.getAttribute('data-variant-id');
          var price = this.getAttribute('data-price');
          var compPrice = this.getAttribute('data-compare-price');
          var available = this.getAttribute('data-available') === 'true';
          var imgUrl = this.getAttribute('data-img-url');

          if (hiddenId) hiddenId.value = variantId;

          if (priceDisplay && price) {
            priceDisplay.innerHTML = price + ' <span class="samyak-price-unit">/ Pack</span>';
          }

          if (comparePrice) {
            if (compPrice) {
              comparePrice.textContent = compPrice;
              comparePrice.style.display = 'inline';
            } else {
              comparePrice.style.display = 'none';
            }
          }

          if (atcBtn) {
            atcBtn.disabled = !available;
          }
          if (buynowBtn) {
            buynowBtn.disabled = !available;
          }
          if (atcLabel) {
            atcLabel.textContent = available ? 'Add to Cart' : 'Sold Out';
          }

          var stockStatus = document.getElementById('samyak-pdp-stock-status');
          if (stockStatus) {
            if (available) {
              stockStatus.innerHTML = '<span class="samyak-stock-dot is-in-stock"></span> <span class="samyak-stock-text" id="samyak-stock-text">In Stock • Ready to dispatch (24–48 hrs)</span>';
            } else {
              stockStatus.innerHTML = '<span class="samyak-stock-dot is-out-of-stock"></span> <span class="samyak-stock-text" id="samyak-stock-text">Currently Out of Stock</span>';
            }
          }

          // Switch image if variant has image
          if (imgUrl && mainImg) {
            mainImg.src = imgUrl;
            // Also highlight thumbnail matching media
            var mediaId = this.getAttribute('data-media-id');
            if (mediaId) {
              var matchingThumb = document.querySelector('.samyak-pdp-thumb[data-media-id="' + mediaId + '"]');
              if (matchingThumb) {
                document.querySelectorAll('.samyak-pdp-thumb').forEach(function(t) { t.classList.remove('is-active'); });
                matchingThumb.classList.add('is-active');
              }
            }
          }
        });
      });
    }

    // 5. Quantity Stepper
    function initQuantity() {
      var dec = document.getElementById('samyak-qty-dec');
      var inc = document.getElementById('samyak-qty-inc');
      var num = document.getElementById('samyak-qty-number');
      var input = document.getElementById('samyak-pdp-qty-field');
      if (!dec || !inc || !num || !input) return;

      var qty = 1;

      dec.addEventListener('click', function() {
        if (qty > 1) {
          qty--;
          num.textContent = qty;
          input.value = qty;
        }
      });

      inc.addEventListener('click', function() {
        qty++;
        num.textContent = qty;
        input.value = qty;
      });
    }

    // 5b. Add to Cart (AJAX)
    function initAddToCart() {
      var form = document.getElementById('samyak-pdp-form');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var atcBtn = document.getElementById('samyak-pdp-btn-atc');
        var atcLabel = document.getElementById('samyak-pdp-atc-label');
        var origText = atcLabel ? atcLabel.textContent : 'Add to cart';

        if (atcLabel) atcLabel.textContent = 'Adding to cart...';
        if (atcBtn) atcBtn.disabled = true;

        var formData = new FormData(form);
        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(res) {
          return res.json();
        })
        .then(function(data) {
          if (atcLabel) atcLabel.textContent = '✓ Added to Cart!';
          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('shopify:cart:refresh', { bubbles: true }));

          // Update header cart badge
          fetch('/cart.js')
            .then(function(r) { return r.json(); })
            .then(function(cartData) {
              var badges = document.querySelectorAll('.samyak-hdr-cart-badge');
              badges.forEach(function(b) {
                b.textContent = cartData.item_count;
                b.style.display = cartData.item_count > 0 ? 'flex' : 'none';
              });
            })
            .catch(function() {});

          function openDrawer() {
            var nativeDrawer = document.getElementById('cart-drawer');
            if (nativeDrawer) {
              if (typeof nativeDrawer.open === 'function') {
                nativeDrawer.open();
              } else {
                nativeDrawer.setAttribute('open', '');
                var panel = nativeDrawer.querySelector('dialog');
                if (panel) {
                  if (typeof panel.showModal === 'function') {
                    try { panel.showModal(); } catch(e) { panel.setAttribute('open', ''); }
                  } else {
                    panel.setAttribute('open', '');
                  }
                }
              }
            }
          }

          // Fetch Section Rendering API to update drawer items live
          fetch('/cart?section_id=cart-drawer-section')
            .then(function(r) { return r.text(); })
            .then(function(html) {
              var container = document.getElementById('shopify-section-cart-drawer') || document.getElementById('cart-drawer');
              if (container) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var newInner = doc.querySelector('.cart-drawer__inner');
                var currentInner = container.querySelector('.cart-drawer__inner');
                if (newInner && currentInner) {
                  currentInner.innerHTML = newInner.innerHTML;
                  currentInner.className = newInner.className;
                }
              }
              if (atcLabel) atcLabel.textContent = origText;
              if (atcBtn) atcBtn.disabled = false;
              openDrawer();
            })
            .catch(function() {
              if (atcLabel) atcLabel.textContent = origText;
              if (atcBtn) atcBtn.disabled = false;
              openDrawer();
            });
        })
        .catch(function(err) {
          console.error('ATC error:', err);
          form.submit();
        });
      });
    }

    // 6. Buy It Now (Wholesale MOQ Enforcement & Direct Checkout)
    function initBuyNow() {
      var buynowBtn = document.getElementById('samyak-pdp-btn-buynow');
      var hiddenId = document.getElementById('samyak-pdp-variant-id');
      var input = document.getElementById('samyak-pdp-qty-field');
      if (!buynowBtn) return;

      buynowBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var id = hiddenId ? hiddenId.value : '';
        var qty = input ? parseInt(input.value, 10) || 1 : 1;
        if (!id) return;

        // Determine variant raw price (Shopify money cents, e.g. 29900 = ₹299.00)
        var swatch = document.querySelector('.samyak-pdp-swatch.is-selected');
        var rawPrice = swatch ? parseInt(swatch.getAttribute('data-raw-price') || '0', 10) : 0;
        if (!rawPrice) {
          rawPrice = {{ current_variant.price | default: 0 }};
        }
        var lineTotal = rawPrice * qty;

        // Wholesale threshold is ₹2,000 = 200,000 cents
        if (lineTotal >= 200000) {
          // Direct checkout allowed because this single item meets/exceeds ₹2,000
          window.location.href = '/cart/' + id + ':' + qty + '?checkout';
        } else {
          // Sub-MOQ: intercepted! Add to cart and open cart drawer to guide customer to reach ₹2,000 MOQ
          buynowBtn.disabled = true;
          var origText = buynowBtn.textContent;
          buynowBtn.textContent = 'ADDING TO BAG...';

          var formData = new FormData();
          formData.append('id', id);
          formData.append('quantity', qty);

          fetch('/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
          .then(function(res) {
            return res.json();
          })
          .then(function(data) {
            buynowBtn.textContent = origText;
            buynowBtn.disabled = false;
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));

            // Refresh drawer and open without full cart redirect
            fetch('/cart?section_id=cart-drawer-section')
              .then(function(r) { return r.text(); })
              .then(function(html) {
                var container = document.getElementById('shopify-section-cart-drawer') || document.getElementById('cart-drawer');
                if (container) {
                  var parser = new DOMParser();
                  var doc = parser.parseFromString(html, 'text/html');
                  var newInner = doc.querySelector('.cart-drawer__inner');
                  var currentInner = container.querySelector('.cart-drawer__inner');
                  if (newInner && currentInner) {
                    currentInner.innerHTML = newInner.innerHTML;
                    currentInner.className = newInner.className;
                  }
                }
                var nativeDrawer = document.getElementById('cart-drawer');
                if (nativeDrawer) {
                  if (typeof nativeDrawer.open === 'function') {
                    nativeDrawer.open();
                  } else {
                    nativeDrawer.setAttribute('open', '');
                  }
                }
              })
              .catch(function() {
                var nativeDrawer = document.getElementById('cart-drawer');
                if (nativeDrawer && typeof nativeDrawer.open === 'function') nativeDrawer.open();
              });
          })
          .catch(function(err) {
            console.error('Buy Now ATC error:', err);
            buynowBtn.textContent = origText;
            buynowBtn.disabled = false;
          });
        }
      });
    }

    // 7. Lightbox Image Zoom
    function initLightbox() {
      var zoomBtn = document.getElementById('samyak-pdp-zoom-btn');
      var lightbox = document.getElementById('samyak-pdp-lightbox');
      var overlay = document.getElementById('samyak-lightbox-close-overlay');
      var closeBtn = document.getElementById('samyak-lightbox-close-btn');
      var lightboxImg = document.getElementById('samyak-lightbox-img');
      var mainImg = document.getElementById('samyak-pdp-main-img');

      if (!zoomBtn || !lightbox || !lightboxImg || !mainImg) return;

      function openZoom() {
        lightboxImg.src = mainImg.src;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeZoom() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      zoomBtn.addEventListener('click', openZoom);
      if (overlay) overlay.addEventListener('click', closeZoom);
      if (closeBtn) closeBtn.addEventListener('click', closeZoom);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && lightbox.classList.contains('is-open')) {
          closeZoom();
        }
      });
    }

    // 7. Wishlist Interaction & Drawer Sync
    function initWishlist() {
      var wishlistBtn = document.getElementById('samyak-pdp-wishlist-btn');
      var wishlistText = document.getElementById('samyak-pdp-wishlist-text');
      if (!wishlistBtn) return;

      var productId = wishlistBtn.getAttribute('data-product-id');
      var STORAGE_KEY = 'samyak_wishlist';

      function getWishlist() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch(e) {
          return [];
        }
      }

      function saveWishlist(items) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        } catch(e) {}
      }

      function updateState() {
        var list = getWishlist();
        var exists = list.some(function(item) {
          var id = typeof item === 'object' && item !== null ? String(item.id) : String(item);
          return id === String(productId);
        });

        if (exists) {
          wishlistBtn.classList.add('is-active');
          wishlistBtn.setAttribute('aria-pressed', 'true');
          if (wishlistText) wishlistText.textContent = '✓ Saved in Wishlist';
        } else {
          wishlistBtn.classList.remove('is-active');
          wishlistBtn.setAttribute('aria-pressed', 'false');
          if (wishlistText) wishlistText.textContent = 'Save to Wishlist';
        }
      }

      updateState();

      wishlistBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var list = getWishlist();
        var idx = -1;
        for (var i = 0; i < list.length; i++) {
          var id = typeof list[i] === 'object' && list[i] !== null ? String(list[i].id) : String(list[i]);
          if (id === String(productId)) {
            idx = i;
            break;
          }
        }

        if (idx > -1) {
          list.splice(idx, 1);
        } else {
          list.push(productId);
        }

        saveWishlist(list);
        updateState();

        document.querySelectorAll('.samyak-wishlist-badge').forEach(function(badge) {
          badge.textContent = list.length;
          badge.style.display = list.length > 0 ? 'flex' : 'none';
        });

        if (typeof window.openWishlistDrawer === 'function') {
          window.openWishlistDrawer();
        }
      });
    }

    // Initialize all components on DOM ready
    function initAll() {
      initPinChecker();
      initThumbnails();
      initVariants();
      initQuantity();
      initAddToCart();
      initBuyNow();
      initLightbox();
      initWishlist();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', initAll);
  })();
</script>
