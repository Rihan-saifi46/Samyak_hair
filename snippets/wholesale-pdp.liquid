{%- doc -%}
  Wholesale Product Details Page (PDP) for Samyak Wholesale.
  Exact 2-column layout matching the reference design:
  - Palette: #F7F5EE warm cream bg, #113B32 deep forest green primary, #C5A280 warm tan accent.
  - Breadcrumb navigation with pill back button.
  - Left column: sticky gallery, 4:5 aspect ratio, zoom button, thumbnail strip, disclaimer box.
  - Right column: Cormorant/Playfair serif title, price, 2 wholesale callout strips, variant pill swatches, quantity stepper, Add to Cart & Buy It Now buttons, safe payment badges, 3-col service box, interactive PIN code estimator, and 4 product details accordions.

  @param {product} product - The product object
  @param {string} section_id - The section id
  @param {object} settings - The section settings
  @param {string} [additional_blocks] - Blocks captured from section
  @param {collection} [collection] - The active or parent collection object
{%- enddoc -%}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image

  # Category detection for dynamic wholesale specifications
  assign prod_type = product.type | downcase
  assign prod_title = product.title | downcase
  assign prod_tags = product.tags | join: ',' | downcase

  assign is_claw = false
  assign is_scrunchie = false
  assign is_hairband = false
  assign is_hairpin = false
  assign is_jewelry = false

  if prod_type contains 'claw' or prod_type contains 'clip' or prod_title contains 'claw' or prod_title contains 'clip' or prod_tags contains 'claw' or prod_tags contains 'clip'
    assign is_claw = true
  elsif prod_type contains 'scrunchie' or prod_type contains 'band' or prod_title contains 'scrunchie' or prod_tags contains 'scrunchie'
    assign is_scrunchie = true
  elsif prod_type contains 'headband' or prod_type contains 'hairband' or prod_title contains 'headband' or prod_title contains 'hairband' or prod_tags contains 'headband' or prod_tags contains 'hairband'
    assign is_hairband = true
  elsif prod_type contains 'pin' or prod_type contains 'barrette' or prod_title contains 'pin' or prod_title contains 'barrette' or prod_tags contains 'pin'
    assign is_hairpin = true
  elsif prod_type contains 'jewelry' or prod_type contains 'earring' or prod_type contains 'necklace' or prod_title contains 'jewelry' or prod_tags contains 'jewelry'
    assign is_jewelry = true
  else
    assign is_claw = true
  endif

  # Collection for back button and breadcrumb
  assign back_url = routes.all_products_collection_url
  assign back_title = 'All Products'
  if collection
    assign back_url = collection.url
    assign back_title = collection.title
  elsif product.collections.size > 0
    assign back_url = product.collections.first.url
    assign back_title = product.collections.first.title
  endif
%}

<div class="samyak-pdp-wrapper" data-section-id="{{ section_id }}">
  <!-- 1. Top Navigation Breadcrumb Bar -->
  <div class="samyak-pdp-top-bar">
    <nav class="samyak-pdp-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="samyak-bc-home" aria-label="Home">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
      </a>
      <span class="samyak-bc-sep">/</span>
      <a href="{{ back_url }}">{{ back_title }}</a>
      <span class="samyak-bc-sep">/</span>
      <span class="samyak-bc-current">{{ product.title }}</span>
    </nav>
  </div>

  <!-- 2. Two-Column Product Grid with Synchronized Card Heights -->
  <div class="samyak-pdp-grid">
    <!-- LEFT COLUMN: Product Image Card -->
    <div class="samyak-pdp-gallery-col">
      <div class="samyak-pdp-main-img-box" id="samyak-main-img-box">
        <!-- Floating circular Wishlist button in top-right corner -->
        <button
          type="button"
          class="samyak-pdp-img-wishlist-btn samyak-wishlist-btn"
          id="samyak-pdp-wishlist-btn"
          data-product-id="{{ product.id }}"
          aria-label="Save to Wishlist"
          title="Save to Wishlist"
        >
          <svg class="samyak-pdp-heart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#113B32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>

        {% if featured_image %}
          <img
            id="samyak-pdp-main-img"
            src="{{ featured_image | image_url: width: 1200 }}"
            alt="{{ featured_image.alt | default: product.title | escape }}"
            width="{{ featured_image.width }}"
            height="{{ featured_image.height }}"
            class="samyak-pdp-main-img"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'samyak-pdp-placeholder-svg' }}
        {% endif %}

        <!-- Floating circular Zoom/Expand button in bottom-right corner -->
        <button
          type="button"
          class="samyak-pdp-zoom-btn"
          id="samyak-pdp-zoom-btn"
          aria-label="Zoom product image"
          title="Click to view full image"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#113B32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="M21 21l-4.35-4.35"/>
            <line x1="11" y1="8" x2="11" y2="14"/>
            <line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </button>
      </div>

      <!-- Compact Thumbnails (if multiple images exist) -->
      {% if product.media.size > 1 %}
        <div class="samyak-pdp-thumbnails-strip" id="samyak-pdp-thumbnails" role="tablist" aria-label="Product Thumbnails">
          {% for media in product.media %}
            {% assign is_active = false %}
            {% if media.id == featured_image.id or forloop.first and featured_image == blank %}
              {% assign is_active = true %}
            {% endif %}
            <button
              type="button"
              role="tab"
              class="samyak-pdp-thumb{% if is_active %} is-active{% endif %}"
              data-media-id="{{ media.id }}"
              data-full-url="{{ media | image_url: width: 1200 }}"
              data-alt="{{ media.alt | default: product.title | escape }}"
              aria-selected="{% if is_active %}true{% else %}false{% endif %}"
              aria-label="Thumbnail {{ forloop.index }} of {{ product.media.size }}"
            >
              <img
                src="{{ media | image_url: width: 140 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="52"
                height="52"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- RIGHT COLUMN: Product Configuration & Actions in Rounded White Card -->
    <div class="samyak-pdp-info-col">
      <div class="samyak-pdp-info-card">
        <!-- Floral Watermark in top-right corner -->
        <div class="samyak-pdp-floral-watermark" aria-hidden="true">
          <svg width="110" height="110" viewBox="0 0 100 100" fill="none">
            <path d="M100 0 C70 12 52 42 46 75 C44 60 40 42 16 36 C42 30 68 15 100 0 Z" fill="#EADCCB" opacity="0.45"/>
            <path d="M100 22 C80 32 66 52 62 86 C60 72 52 56 32 50 C52 44 72 32 100 22 Z" fill="#EADCCB" opacity="0.3"/>
          </svg>
        </div>

        <div class="samyak-pdp-info-top">
          <!-- 1. Product Title -->
          <h1 class="samyak-pdp-title">{{ product.title }}</h1>

          <!-- 2. Product Price -->
          <div class="samyak-pdp-price-row" id="samyak-pdp-price-row">
            <span class="samyak-pdp-current-price" id="samyak-pdp-price-display">
              {{ current_variant.price | money }}
            </span>
            <span class="samyak-pdp-price-sep">|</span>
            <span class="samyak-pdp-price-unit">Per Pc</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="samyak-pdp-compare-price" id="samyak-pdp-compare-price">
                {{ current_variant.compare_at_price | money }}
              </span>
            {% endif %}
          </div>
        </div>

        <!-- 3. Form & Controls -->
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="samyak-pdp-form" class="samyak-pdp-form">
          <input type="hidden" name="id" id="samyak-pdp-variant-id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="samyak-pdp-qty-field" value="1">

          <!-- Available Options or Variants (if variants exist) -->
          {% if product.variants.size > 1 %}
            <div class="samyak-pdp-variants-section">
              <label class="samyak-pdp-section-label">AVAILABLE OPTIONS / VARIANTS</label>
              <div class="samyak-pdp-swatches-row" role="radiogroup" aria-label="Select Variant">
                {% for variant in product.variants %}
                  {% assign is_selected = false %}
                  {% if variant.id == current_variant.id %}
                    {% assign is_selected = true %}
                  {% endif %}
                  <button
                    type="button"
                    role="radio"
                    class="samyak-pdp-swatch{% if is_selected %} is-selected{% endif %}{% unless variant.available %} is-sold-out{% endunless %}"
                    data-variant-id="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-raw-price="{{ variant.price }}"
                    data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-available="{{ variant.available }}"
                    data-media-id="{{ variant.featured_media.id | default: '' }}"
                    data-img-url="{{ variant.featured_image | image_url: width: 1200 | default: '' }}"
                    aria-checked="{% if is_selected %}true{% else %}false{% endif %}"
                  >
                    {{ variant.title }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <!-- 4. Quantity Stepper Row -->
          <div class="samyak-pdp-qty-row">
            <span class="samyak-pdp-qty-label">QUANTITY</span>
            <div class="samyak-pdp-qty-pill" aria-label="Product Quantity Stepper">
              <button type="button" class="samyak-qty-btn" id="samyak-qty-dec" aria-label="Decrease quantity">−</button>
              <span class="samyak-qty-number" id="samyak-qty-number">1</span>
              <button type="button" class="samyak-qty-btn" id="samyak-qty-inc" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <!-- 5. Stock & Dispatch Status Row -->
          <div class="samyak-pdp-stock-dispatch-row" id="samyak-pdp-stock-status">
            <div class="samyak-pdp-stock-item">
              <span class="samyak-stock-dot {% if current_variant.available %}is-in-stock{% else %}is-out-of-stock{% endif %}"></span>
              <span class="samyak-stock-text" id="samyak-stock-text">
                {% if current_variant.available %}In Stock{% else %}Out of Stock{% endif %}
              </span>
            </div>
            <div class="samyak-pdp-dispatch-item">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Ready to dispatch (2-3 days)</span>
            </div>
          </div>

          <!-- 6. Action Buttons: ADD TO CART + BUY NOW Side-by-Side -->
          <div class="samyak-pdp-actions">
            <button
              type="submit"
              class="samyak-pdp-btn-atc"
              id="samyak-pdp-btn-atc"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span id="samyak-pdp-atc-label">
                {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
              </span>
            </button>

            <button
              type="button"
              class="samyak-pdp-btn-buynow"
              id="samyak-pdp-btn-buynow"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>BUY NOW</span>
            </button>
          </div>
        </form>

        <!-- 7. Trust Badges Row -->
        <div class="samyak-pdp-trust-badges">
          <div class="samyak-trust-badge">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span>Secure Checkout</span>
          </div>
          <div class="samyak-trust-badge">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Fast Delivery</span>
          </div>
          <div class="samyak-trust-badge">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1 4 1 10 7 10"></polyline>
              <polyline points="23 20 23 14 17 14"></polyline>
              <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
            </svg>
            <span>Easy Returns</span>
          </div>
        </div>

        {% if additional_blocks != blank %}
          <!-- Theme Editor App Blocks & Merchant Widgets -->
          <div class="samyak-pdp-additional-blocks-wrapper" data-theme-editor-blocks>
            {{ additional_blocks }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- SECTION 3: ABOUT THIS PRODUCT -->
  <section class="samyak-pdp-about-section" id="samyak-pdp-about">
    <div class="samyak-pdp-about-container">
      <div class="samyak-section-golden-heading">
        <span class="samyak-golden-line"></span>
        <h2 class="samyak-golden-title">About This Product</h2>
        <span class="samyak-golden-line"></span>
      </div>
      <div class="samyak-pdp-about-body rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>
            Premium wholesale hair accessory crafted for comfortable, secure, all-day wear. Designed with attention to detail and durability, suitable for daily styling, festive occasions, and professional salon styling.
          </p>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- Lightbox Modal for Image Zoom -->
  <div class="samyak-pdp-lightbox" id="samyak-pdp-lightbox" aria-hidden="true">
    <div class="samyak-pdp-lightbox-overlay" id="samyak-lightbox-close-overlay"></div>
    <div class="samyak-pdp-lightbox-inner">
      <button type="button" class="samyak-lightbox-close-btn" id="samyak-lightbox-close-btn" aria-label="Close zoom modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <img id="samyak-lightbox-img" src="" alt="Full size preview" class="samyak-lightbox-img" width="1000" height="1000">
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     SAMYAK WHOLESALE PDP STYLING
     Exact Reference Matching:
     Background: #F7F5EE | Primary: #113B32 | Secondary Accent: #C5A280
     Cards: #FCFBF7 | Borders: #E4E0D6 | Muted Text: #5C615E | Darks: #181A19
     ========================================================================== */

  .samyak-pdp-wrapper {
    background-color: #F7F5EE;
    color: #181A19;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    padding-bottom: 60px;
  }

  /* 1. Top Breadcrumb Bar */
  .samyak-pdp-top-bar {
    max-width: 1040px;
    margin: 0 auto;
    padding: 24px 20px 14px;
    box-sizing: border-box;
  }

  .samyak-pdp-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #6B7280;
    flex-wrap: wrap;
    font-family: var(--font-body--family, 'Plus Jakarta Sans', -apple-system, sans-serif);
  }

  .samyak-bc-home {
    display: inline-flex;
    align-items: center;
    color: #113B32;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .samyak-bc-home:hover {
    opacity: 0.75;
  }

  .samyak-pdp-breadcrumbs a {
    color: #6B7280;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .samyak-pdp-breadcrumbs a:hover {
    color: #113B32;
    text-decoration: underline;
  }

  .samyak-bc-sep {
    color: #D1D5DB;
    font-size: 13px;
  }

  .samyak-bc-current {
    color: #113B32;
    font-weight: 500;
  }

  /* 2. Two-Column Grid with Equal Card Heights */
  .samyak-pdp-grid {
    display: grid;
    grid-template-columns: 1fr 1.12fr;
    gap: clamp(16px, 2.5vw, 32px);
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
    align-items: stretch;
  }

  /* LEFT COLUMN: Gallery Matching Right Box Height Exactly */
  .samyak-pdp-gallery-col {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
  }

  .samyak-pdp-main-img-box {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 20px;
    background: #FFFFFF;
    border: 1px solid #ECE6DF;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    padding: 0;
    box-sizing: border-box;
  }

  .samyak-pdp-main-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: opacity 0.25s ease;
  }

  .samyak-pdp-placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
  }

  /* Floating Wishlist Button on Top-Right of Main Image */
  .samyak-pdp-img-wishlist-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    padding: 0;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .samyak-pdp-img-wishlist-btn:hover {
    background: #FAF7F2;
    transform: scale(1.08);
  }

  .samyak-pdp-img-wishlist-btn.is-active svg {
    fill: #E53E3E !important;
    stroke: #E53E3E !important;
  }

  /* Floating Zoom Button on Bottom-Right of Main Image */
  .samyak-pdp-zoom-btn {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s ease, background-color 0.2s ease;
    z-index: 5;
  }

  .samyak-pdp-zoom-btn:hover {
    background: #FAF7F2;
    transform: scale(1.08);
  }

  .samyak-pdp-thumbnails-strip {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    overflow-x: auto;
    padding-bottom: 2px;
    justify-content: center;
  }

  .samyak-pdp-thumb {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border-radius: 8px;
    border: 1px solid #ECE6DF;
    background: #FAF7F2;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .samyak-pdp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .samyak-pdp-thumb:hover {
    border-color: #113B32;
  }

  .samyak-pdp-thumb.is-active {
    border: 1.5px solid #113B32;
    box-shadow: 0 2px 6px rgba(17, 59, 50, 0.15);
  }

  /* RIGHT COLUMN: Product Information Card Defining Natural Height */
  .samyak-pdp-info-col {
    display: flex;
    flex-direction: column;
  }

  .samyak-pdp-info-card {
    background: #FFFFFF;
    border: 1px solid #ECE6DF;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    padding: 24px 28px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .samyak-pdp-floral-watermark {
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.35;
  }

  .samyak-pdp-title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: clamp(21px, 2.1vw, 26px);
    font-weight: 500;
    color: #113B32;
    line-height: 1.25;
    margin: 0 0 6px 0;
    letter-spacing: 0.01em;
    position: relative;
    z-index: 1;
  }

