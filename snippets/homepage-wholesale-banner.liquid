<style>
  .samyak-connect-banner {
    width: 100%;
    padding-block: 24px 48px;
    background: #F7F5EE;
  }

  .samyak-connect-banner__container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .samyak-connect-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .samyak-connect-card {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.5vw, 24px);
    padding: 24px clamp(20px, 3vw, 32px);
    border-radius: 14px;
    color: #ffffff;
    text-decoration: none;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .samyak-connect-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .samyak-connect-card--ig {
    background: linear-gradient(110deg, #ffd600 0%, #ff7a00 25%, #f50057 55%, #c13584 75%, #833ab4 100%);
  }

  .samyak-connect-card--wa {
    background: linear-gradient(110deg, #128C7E 0%, #25D366 100%);
  }

  .samyak-connect-icon {
    display: block;
    width: clamp(38px, 6vw, 46px);
    height: clamp(38px, 6vw, 46px);
    flex: 0 0 clamp(38px, 6vw, 46px);
  }

  .samyak-connect-text {
    min-width: 0;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .samyak-connect-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.9;
    text-transform: uppercase;
  }

  .samyak-connect-title {
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 800;
    line-height: 1.2;
    margin: 2px 0 3px;
  }

  .samyak-connect-handle {
    font-size: clamp(13px, 1.8vw, 15px);
    opacity: 0.95;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .samyak-connect-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .samyak-connect-card {
      padding: 18px 20px;
    }
  }
</style>
