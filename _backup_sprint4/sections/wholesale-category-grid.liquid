{% comment %}
  Section contract: 3D Stacked Perspective Carousel for Collections Showcase
  Renders the interactive 3D Coverflow carousel ("FOR EVERY YOU") featuring the 5 Hair Accessory collections.
{% endcomment %}

{% render 'homepage-category-grid', section: section %}

{% schema %}
{
  "name": "3D Collection Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FOR EVERY YOU"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "For every mood, moment, and milestone — there is a piece that speaks your style."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#113B32"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#5C615E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F7F5EE"
    }
  ],
  "blocks": [
    {
      "type": "collection_slide",
      "name": "Collection Slide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Collection Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale Category Grid",
      "blocks": [
        {
          "type": "collection_slide",
          "settings": {
            "title": "HAIR CLIPS / CLUTCHERS"
          }
        },
        {
          "type": "collection_slide",
          "settings": {
            "title": "HAIR BAND"
          }
        },
        {
          "type": "collection_slide",
          "settings": {
            "title": "KIDS"
          }
        },
        {
          "type": "collection_slide",
          "settings": {
            "title": "FALSE HAIR"
          }
        },
        {
          "type": "collection_slide",
          "settings": {
            "title": "SCRUNCHIES & RUBBERS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
