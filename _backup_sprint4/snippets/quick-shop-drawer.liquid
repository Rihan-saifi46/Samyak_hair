</style>

<script>
  (function() {
    function initQuickShopDrawer() {
      var modal = document.getElementById('samyak-quick-shop-modal') || document.getElementById('samyak-quick-shop-drawer');
      if (!modal || modal.dataset.initialized === 'true') return;
      modal.dataset.initialized = 'true';

      var showcaseImg = document.getElementById('samyak-drawer-img');
      var titleEl = document.getElementById('samyak-drawer-title');
      var priceEl = document.getElementById('samyak-drawer-price');
      var optionLabelEl = document.getElementById('samyak-drawer-option-label');
      var variantsList = document.getElementById('samyak-drawer-variants-list');
      var addBtn = document.getElementById('samyak-drawer-add-btn');
      var btnText = document.getElementById('samyak-drawer-btn-text');
      var pdpLink = document.getElementById('samyak-drawer-pdp-link');
      var feedbackEl = document.getElementById('samyak-drawer-feedback');

      var currentProduct = null;
      var selectedVariant = null;

      function formatMoney(cents) {
        if (cents == null) return '';
        var num = typeof cents === 'number' ? cents : parseFloat(cents);
        // If cents is already in full currency or in paise:
        var amount;
        if (num > 10000 && num % 100 === 0) {
          amount = (num / 100).toLocaleString('en-IN');
        } else if (num > 10000) {
          amount = (num / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 });
        } else {
          amount = (num / 100).toLocaleString('en-IN', { maximumFractionDigits: (num % 100 === 0 ? 0 : 2) });
        }
        return '₹' + amount;
      }

      function openDrawer(productData) {
        currentProduct = productData;
        if (!currentProduct) return;

        if (feedbackEl) {
          feedbackEl.style.display = 'none';
          feedbackEl.textContent = '';
        }

        // Set Product Image
        var mainImg = currentProduct.featured_image || (currentProduct.images && currentProduct.images[0]) || '';
        if (typeof mainImg === 'object' && mainImg.src) mainImg = mainImg.src;
        if (mainImg) {
          showcaseImg.src = mainImg;
        }
        showcaseImg.alt = currentProduct.title || 'Product Image';

        // Set Product Title & PDP Link
        titleEl.textContent = currentProduct.title;
        var productUrl = currentProduct.url || ('/products/' + currentProduct.handle);
        pdpLink.href = productUrl;

        // Set Option Label
        if (currentProduct.options && currentProduct.options.length > 0) {
          var firstOpt = currentProduct.options[0];
          var optName = typeof firstOpt === 'object' ? firstOpt.name : firstOpt;
          if (optName && optName.toLowerCase() !== 'title') {
            optionLabelEl.textContent = 'CHOOSE YOUR ' + optName.toUpperCase();
          } else {
            optionLabelEl.textContent = 'CHOOSE YOUR PACK / VARIANT';
          }
        } else {
          optionLabelEl.textContent = 'CHOOSE YOUR PACK / VARIANT';
        }

        // Handle Variants List
        variantsList.innerHTML = '';
        var variants = currentProduct.variants || [];

        if (variants.length > 0) {
          var firstAvail = variants.find(function(v) { return v.available; }) || variants[0];
          selectedVariant = firstAvail;

          variants.forEach(function(variant) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'samyak-drawer-variant-btn';
            btn.setAttribute('data-variant-id', variant.id);
            btn.setAttribute('role', 'radio');

            var titleStr = variant.title === 'Default Title' ? currentProduct.title : variant.title;
            btn.textContent = titleStr;

            if (!variant.available) {
              btn.classList.add('is-unavailable');
              btn.setAttribute('aria-disabled', 'true');
              btn.title = 'Out of Stock';
            }

            if (variant.id === selectedVariant.id) {
              btn.classList.add('is-selected');
              btn.setAttribute('aria-checked', 'true');
            } else {
              btn.setAttribute('aria-checked', 'false');
            }

            btn.addEventListener('click', function(e) {
              e.preventDefault();
              selectVariant(variant, btn);
            });

            variantsList.appendChild(btn);
          });
        } else {
          selectedVariant = {
            id: currentProduct.id,
            price: currentProduct.price,
            available: true
          };
        }

        updatePriceAndButton();

        // Open Modal
        modal.classList.add('samyak-quick-shop-drawer--open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function selectVariant(variant, clickedBtn) {
        selectedVariant = variant;

        var allBtns = variantsList.querySelectorAll('.samyak-drawer-variant-btn');
        allBtns.forEach(function(b) {
          b.classList.remove('is-selected');
          b.setAttribute('aria-checked', 'false');
        });
        if (clickedBtn) {
          clickedBtn.classList.add('is-selected');
          clickedBtn.setAttribute('aria-checked', 'true');
        }

        if (variant.featured_image) {
          var variantImg = typeof variant.featured_image === 'object' ? variant.featured_image.src : variant.featured_image;
          if (variantImg) {
            showcaseImg.src = variantImg;
          }
        }

        updatePriceAndButton();
      }

      function updatePriceAndButton() {
        if (!selectedVariant) return;

        var formattedPrice = formatMoney(selectedVariant.price);
        priceEl.textContent = formattedPrice;

        if (selectedVariant.available) {
          addBtn.disabled = false;
          addBtn.classList.remove('is-added');
          btnText.textContent = 'ADD TO BAG';
        } else {
          addBtn.disabled = true;
          addBtn.classList.remove('is-added');
          btnText.textContent = 'OUT OF STOCK';
        }
      }

      function closeDrawer() {
        modal.classList.remove('samyak-quick-shop-drawer--open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      modal.querySelectorAll('[data-drawer-close]').forEach(function(el) {
        el.addEventListener('click', function(e) {
          e.preventDefault();
          closeDrawer();
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('samyak-quick-shop-drawer--open')) {
          closeDrawer();
        }
      });

      // Primary CTA: Add to Bag Action
      addBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (!selectedVariant || !selectedVariant.available || addBtn.disabled) return;

        addBtn.disabled = true;
        btnText.textContent = 'ADDING...';
        if (feedbackEl) feedbackEl.style.display = 'none';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: selectedVariant.id,
              quantity: 1
            }]
          })
        })
        .then(function(res) {
          if (!res.ok) {
            return res.json().then(function(err) { throw err; });
          }
          return res.json();
        })
        .then(function(item) {
          btnText.textContent = '✓ ADDED TO BAG';
          addBtn.classList.add('is-added');

          // 1. Refresh background cart drawer section HTML via synchronized Section Rendering API
          fetch('/cart?section_id=cart-drawer')
            .then(function(r) { return r.text(); })
            .then(function(html) {
              var parser = new DOMParser();
              var doc = parser.parseFromString(html, 'text/html');
              var newInner = doc.querySelector('.cart-drawer__inner') || doc.querySelector('cart-drawer-component') || doc.querySelector('#cart-drawer');
              var curInner = document.querySelector('.cart-drawer__inner') || document.querySelector('cart-drawer-component') || document.querySelector('#cart-drawer');
              if (newInner && curInner) {
                curInner.innerHTML = newInner.innerHTML;
              }
            })
            .catch(function(err) {
              console.warn('[QuickShop] Cart section refresh error:', err);
            });

          // 2. Refresh cart counts and badges
          fetch('/cart.js')
            .then(function(r) { return r.json(); })
            .then(function(cart) {
              document.querySelectorAll('.cart-count, [data-cart-count], .header-actions__cart-icon, .cart-count-bubble').forEach(function(el) {
                if (el.classList.contains('header-actions__cart-icon')) {
                  el.classList.toggle('header-actions__cart-icon--has-cart', cart.item_count > 0);
                }
                var bubble = el.querySelector('.header-actions__cart-count') || el.querySelector('.cart-count-bubble') || el;
                if (bubble && bubble !== el) bubble.textContent = cart.item_count;
                else if (el.classList.contains('cart-count-bubble')) el.textContent = cart.item_count;
              });

              document.querySelectorAll('.theme-drawer__badge').forEach(function(badge) {
                badge.textContent = cart.item_count;
                badge.classList.toggle('visually-hidden', cart.item_count === 0);
              });

              // Dispatch standard cart event
              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { cart: cart } }));
            });

          // 3. Close Quick Shop drawer and slide open native <cart-drawer>
          setTimeout(function() {
            closeDrawer();
            addBtn.disabled = false;
            addBtn.classList.remove('is-added');
            btnText.textContent = 'ADD TO BAG';

            var themeDrawer = document.getElementById('cart-drawer');
            if (themeDrawer && typeof themeDrawer.open === 'function') {
              themeDrawer.open();
            } else if (themeDrawer) {
              themeDrawer.classList.add('active');
              themeDrawer.setAttribute('open', '');
            }
          }, 350);
        })
        .catch(function(err) {
          addBtn.disabled = false;
          btnText.textContent = 'ADD TO BAG';
          if (feedbackEl) {
            feedbackEl.style.display = 'block';
            feedbackEl.textContent = err.description || err.message || 'Unable to add to bag. Please try again.';
          }
        });
      });

      // Event Delegation for QUICK SHOP Pill Buttons
      document.addEventListener('click', function(e) {
        var trigger = e.target.closest('[data-quick-shop-trigger]');
        if (!trigger) return;

        e.preventDefault();
        e.stopPropagation();

        var card = trigger.closest('.product-card') || trigger.closest('[data-product-id]') || trigger.closest('.card-gallery') || trigger.parentElement;
        var jsonScript = card ? card.querySelector('.samyak-product-json') : null;

        if (jsonScript && jsonScript.textContent.trim()) {
          try {
            var data = JSON.parse(jsonScript.textContent);
            openDrawer(data);
            return;
          } catch (err) {
            console.warn('Error parsing product json:', err);
          }
        }

        var handle = trigger.getAttribute('data-product-handle');
        if (handle) {
          trigger.style.opacity = '0.7';
          fetch('/products/' + handle + '.js')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              trigger.style.opacity = '';
              openDrawer(data);
            })
            .catch(function(err) {
              trigger.style.opacity = '';
              console.error('Failed to load product data:', err);
            });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQuickShopDrawer);
    } else {
      initQuickShopDrawer();
    }
  })();
</script>
