{% doc %}
  Renders the Slide-Over Split Quick Shop Drawer for Samyak Wholesale.
  Exact match to reference design (image_97692e.jpg):
  - Full-screen dimmed & blurred backdrop (rgba(17, 36, 28, 0.58), blur(8px))
  - 2-Column Split Drawer (58vw, max 780px, min 340px, height 100dvh)
  - Left: Warm stone showcase (#EFECE4) with high-res product photo
  - Right: Editorial ivory panel (#FCFBF7) with Cormorant Garamond serif title,
    forest green price, stacked vertical variant pills, and full-width "ADD TO BAG" CTA
    directly integrated with Shopify AJAX Cart API and the native <cart-drawer>.
{% enddoc %}

<div
  id="samyak-quick-shop-modal"
  class="samyak-quick-shop-drawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="samyak-drawer-title"
>
  <!-- Full-Screen Blurred Backdrop -->
  <div class="samyak-drawer-backdrop" data-drawer-close aria-hidden="true"></div>

  <!-- Split 2-Column Drawer Container -->
  <div class="samyak-drawer-container" role="document">
    <!-- Left Half: Full-Height Product Showcase -->
    <div class="samyak-drawer-showcase">
      <img
        id="samyak-drawer-img"
        src="{{ 'samyak-card-1.jpg' | asset_url }}"
        alt="Product Showcase"
        class="samyak-drawer-img"
        loading="lazy"
        width="500"
        height="600"
      >
    </div>

    <!-- Right Half: Product Configuration & Actions -->
    <div class="samyak-drawer-content">
      <!-- Top-Right Circular Close Button (×) -->
      <button
        type="button"
        class="samyak-drawer-close-btn"
        data-drawer-close
        aria-label="Close Quick Shop"
        title="Close"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Eyebrow Label -->
      <span class="samyak-drawer-eyebrow">QUICK SHOP</span>

      <!-- Product Title -->
      <h2 id="samyak-drawer-title" class="samyak-drawer-title">Product Title</h2>

      <!-- Price -->
      <div id="samyak-drawer-price" class="samyak-drawer-price">₹0</div>

      <!-- Variant / Pack Selector -->
      <div class="samyak-drawer-variants-section">
        <span class="samyak-drawer-variant-label" id="samyak-drawer-option-label">CHOOSE YOUR PACK / VARIANT</span>
        <div id="samyak-drawer-variants-list" class="samyak-drawer-variants-list" role="radiogroup" aria-labelledby="samyak-drawer-option-label">
          <!-- Dynamically populated vertical variant pill buttons -->
        </div>
      </div>

      <!-- Feedback / Error Notice -->
      <div id="samyak-drawer-feedback" class="samyak-drawer-feedback" style="display: none;"></div>

      <!-- Primary CTA Button: ADD TO BAG -->
      <button
        type="button"
        id="samyak-drawer-add-btn"
        class="samyak-drawer-add-btn"
        aria-label="Add to Bag"
      >
        <span id="samyak-drawer-btn-text">ADD TO BAG</span>
      </button>

      <!-- Bottom PDP Link -->
      <a id="samyak-drawer-pdp-link" href="#" class="samyak-drawer-pdp-link">
        <span>View full product details</span>
        <span class="samyak-drawer-pdp-arrow">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     SPLIT SLIDE-OVER QUICK SHOP DRAWER (#samyak-quick-shop-modal)
     ========================================================================== */

  #samyak-quick-shop-modal,
  .samyak-quick-shop-drawer {
    position: fixed !important;
    inset: 0 !important;
    z-index: 9998 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: visibility 0.35s ease !important;
  }

  #samyak-quick-shop-modal.samyak-quick-shop-drawer--open,
  .samyak-quick-shop-drawer.samyak-quick-shop-drawer--open {
    visibility: visible !important;
    pointer-events: auto !important;
  }

