      "settings": {
        "custom_liquid": "<style>\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-banner {\n    display:flex; align-items:center; gap:clamp(14px,2.5vw,26px); width:calc(100% - 32px); max-width:560px;\n    margin:0 auto; padding:24px clamp(18px,3vw,30px); border-radius:16px;\n    color:#fff; text-decoration:none;\n    background:linear-gradient(110deg,#ffd600 0%,#ff7a00 27%,#f50057 58%,#c13584 78%,#833ab4 100%);\n    box-sizing:border-box; min-width:0; overflow:hidden;\n  }\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-icon {\n    display:block; width:clamp(40px,9vw,50px); height:clamp(40px,9vw,50px); flex:0 0 clamp(40px,9vw,50px);\n  }\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-divider {\n    width:1px; height:56px; background:rgba(255,255,255,.8); flex:0 0 1px;\n  }\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-copy { min-width:0; flex:1 1 auto; }\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-heading {\n    margin:0; color:#fff; font-size:clamp(15px,3.4vw,24px); font-weight:800;\n    line-height:1.15; letter-spacing:.02em; overflow-wrap:anywhere;\n  }\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-handle {\n    margin:6px 0 0; color:#fff; font-size:clamp(14px,2.6vw,18px); line-height:1.3;\n    overflow-wrap:anywhere; word-break:break-word;\n  }\n  #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-banner:focus-visible {\n    outline:3px solid #171717; outline-offset:4px;\n  }\n  @media(max-width:520px) {\n    #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-banner {\n      gap:12px; padding:20px 16px; border-radius:14px;\n    }\n    #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-divider { height:50px; }\n    #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-heading { font-size:clamp(14px,4vw,19px); }\n    #shopify-section-template--28229845778545__custom_liquid_MQA9UW .instagram-handle { margin-top:5px; font-size:14px; }\n  }\n</style>\n<a class=\"instagram-banner\" href=\"https://www.instagram.com/parulcreationswholesaleofficial/\" aria-label=\"Follow us on Instagram at parulcreationswholesaleofficial\">\n  <svg class=\"instagram-icon\" viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n    <rect x=\"8\" y=\"8\" width=\"48\" height=\"48\" rx=\"14\" stroke=\"white\" stroke-width=\"4\"/>\n    <circle cx=\"32\" cy=\"32\" r=\"11\" stroke=\"white\" stroke-width=\"4\"/>\n    <circle cx=\"47\" cy=\"17\" r=\"3\" fill=\"white\"/>\n  </svg>\n  <span class=\"instagram-divider\" aria-hidden=\"true\"></span>\n  <span class=\"instagram-copy\">\n    <span class=\"instagram-heading\" style=\"display:block\">FOLLOW US ON INSTAGRAM</span>\n    <span class=\"instagram-handle\" style=\"display:block\">parulcreationswholesaleofficial</span>\n  </span>\n</a>",
