center; justify-content:center; font-size:15px; font-weight:700; }\n  #shopify-section-template--28229845778545__custom_liquid_fTMk68 .review-name { margin:0; font-weight:650; color:#202525; font-size:15px; line-height:1.3; }\n  #shopify-section-template--28229845778545__custom_liquid_fTMk68 .review-meta { color:#727a78; font-size:13px; margin:3px 0 0; line-height:1.4; }\n  #shopify-section-template--28229845778545__custom_liquid_fTMk68 .review-product { margin:8px 0 0; color:#555e5c; font-size:14px; }\n  @media(max-width:760px) {\n    #shopify-section-template--28229845778545__custom_liquid_fTMk68 .reviews-section { padding:40px 18px; }\n    #shopify-section-template--28229845778545__custom_liquid_fTMk68 .reviews-title { margin-bottom:26px; }\n    #shopify-section-template--28229845778545__custom_liquid_fTMk68 .reviews-layout { grid-template-columns:1fr; gap:24px; }\n    #shopify-section-template--28229845778545__custom_liquid_fTMk68 .review-list { grid-template-columns:1fr; gap:18px; }\n  }\n</style>\n<section class=\"reviews-section\" aria-labelledby=\"customer-reviews-title\">\n  <div class=\"reviews-inner\">\n    <h2 class=\"reviews-title\" id=\"customer-reviews-title\">Customer Reviews</h2>\n    <div class=\"reviews-layout\">\n      <div class=\"review-summary\">\n        <div class=\"score-row\"><span class=\"score\">4.6</span><span class=\"stars\" aria-label=\"5 stars\">★★★★★</span><span class=\"review-count\">out of 5 · 94 reviews</span></div>\n      </div>\n      <div class=\"review-list\">\n        <article class=\"review-card\"><div class=\"review-person\"><span class=\"review-avatar\" aria-hidden=\"true\">A</span><div><h3 class=\"review-name\">Arun Raj</h3><p class=\"review-meta\">Muttupet Tamil Nadu · 25-Oct-2026</p></div></div><div class=\"stars\" aria-label=\"5 stars\">★★★★★</div><p class=\"review-product\">Flower Hair Clips</p></article>\n        <article class=\"review-card\"><div class=\"review-person\"><span class=\"review-avatar\" aria-hidden=\"