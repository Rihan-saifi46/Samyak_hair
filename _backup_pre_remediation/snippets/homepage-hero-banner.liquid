      <path d="M142 95 L168 76"/>
    </svg>
  </div>

  <!-- Hero Content Grid -->
  <div class="samyak-hero-container">
    <!-- LEFT COLUMN: Editorial Typography & Double-Bordered CTA -->
    <div class="samyak-hero-left">
      <!-- Top Ornamental Divider -->
      <div class="samyak-ornament-divider" aria-hidden="true">
        <span class="samyak-ornament-line-long"></span>
        <span class="samyak-ornament-dot"></span>
