            class="samyak-photo-portrait-img"
            width="340"
            height="460"
            fetchpriority="high"
            loading="eager"
          >
        </div>

        <!-- Secondary Overlapping Flat-Lay Photo (Front Right Layer) -->
        <div class="samyak-photo-flatlay-box">
          <img
            src="{{ 'samyak-hero-flatlay.jpg' | asset_url }}"
            alt="Luxury emerald-gold claw clips and pearl pins arranged on travertine stone"
            class="samyak-photo-flatlay-img"
            width="310"
            height="365"
            loading="eager"
          >
        </div>
      </div>
    </div>
