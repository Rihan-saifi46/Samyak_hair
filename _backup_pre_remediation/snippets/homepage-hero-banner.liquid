</section>

<style>
  /* ==========================================================================
     SAMYAK EDITORIAL LUXURY HERO BANNER
     Exact Match to image_3625e2.jpg:
     Warm Champagne/Sand palette, sunlit window-blind streaks, botanical line-art,
     and overlapping two-photo editorial collage.
     ========================================================================== */

  .samyak-editorial-hero {
    position: relative;
    z-index: 1;
    width: 100%;
    height: calc(100vh - 96px);
    height: calc(100dvh - 96px);
    min-height: 560px;
    background: linear-gradient(115deg, #EAE3D5 0%, #DFD6C5 48%, #EFECE4 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  /* Sunlit Diagonal Window-Blind Shadows Overlay */
  .samyak-hero-sunlight-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: linear-gradient(
      125deg,
      rgba(255, 255, 255, 0.45) 0%,
      rgba(196, 184, 164, 0.28) 28%,
      rgba(255, 255, 255, 0.4) 55%,
      rgba(190, 178, 158, 0.25) 82%,
      rgba(255, 255, 255, 0.35) 100%
    );
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  /* Subtle Warm-Gold Botanical Line-Art SVG Accents */
  .samyak-botanical-top {
    position: absolute;
    top: -20px;
    left: 41%;
    z-index: 2;
    pointer-events: none;
    opacity: 0.45;
  }

  .samyak-botanical-bottom {
    position: absolute;
    bottom: -30px;
    left: 39%;
    z-index: 2;
    pointer-events: none;
    opacity: 0.45;
  }

  /* Hero Content Container */
  .samyak-hero-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1440px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  /* LEFT COLUMN: 44% Width, Padding 7% */
  .samyak-hero-left {
    width: 44%;
    padding-left: 7%;
    padding-right: 3%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  /* Top & Bottom Ornamental Dividers (Line + Dot + Line) */
  .samyak-ornament-divider {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2px;
  }

  .samyak-ornament-line-long {
    width: 68px;
    height: 1.5px;
    background-color: #9E825C;
    display: block;
  }

  .samyak-ornament-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #9E825C;
    display: block;
  }

  .samyak-ornament-line-short {
    width: 18px;
    height: 1.5px;
    background-color: #9E825C;
    display: block;
  }

  .samyak-ornament-bottom {
    margin-top: 38px;
  }

  /* Eyebrow Subtitle */
  .samyak-hero-eyebrow {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7D6B52;
    margin: 18px 0 14px;
    line-height: 1.2;
  }

  /* Main Display Headline */
  .samyak-hero-headline {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    font-size: clamp(38px, 4.2vw, 56px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #163A28; /* Deep emerald-forest green */
    margin: 0;
  }

  /* Double-Bordered Luxury Pill CTA Button */
  .samyak-hero-cta-wrapper {
    margin-top: 32px;
  }

  .samyak-double-pill-btn {
    display: inline-block;
    padding: 3px;
    border: 1px solid #B69D74;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .samyak-double-pill-btn:hover {
    transform: translateY(-2px);
    border-color: #9E825C;
  }

  .samyak-inner-pill-btn {
    display: inline-block;
    padding: 13px 30px;
    background: #FAF8F3;
    border: 1px solid #C8B596;
    border-radius: 999px;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #181A19;
    box-shadow: 0 4px 14px rgba(158, 130, 92, 0.12);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .samyak-double-pill-btn:hover .samyak-inner-pill-btn {
    background: #FFFFFF;
    color: #163A28;
  }

  /* RIGHT COLUMN: 56% Width Overlapping Photo Collage */
  .samyak-hero-right {
    width: 56%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-right: 5%;
    box-sizing: border-box;
  }

  .samyak-collage-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 620px;
  }

  /* Primary Portrait Photo (Back Layer) */
  .samyak-photo-portrait-box {
    position: relative;
    width: clamp(260px, 24vw, 340px);
    height: clamp(360px, 34vw, 460px);
    z-index: 10;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .samyak-photo-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Secondary Overlapping Flat-Lay Photo (Front Right Layer) */
  .samyak-photo-flatlay-box {
    position: relative;
    width: clamp(240px, 22vw, 310px);
    height: clamp(285px, 26vw, 365px);
    border: 4px solid #FAF8F3;
    box-shadow: -12px 16px 36px rgba(24, 26, 25, 0.16);
    margin-left: -48px;
    margin-top: 48px;
    z-index: 20;
    flex-shrink: 0;
    overflow: hidden;
  }

  .samyak-photo-flatlay-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (< 1024px)
     ========================================================================== */
  @media screen and (max-width: 1024px) {
    .samyak-editorial-hero {
      height: auto;
      min-height: auto;
      padding: 50px 24px 60px;
    }

    .samyak-hero-container {
      flex-direction: column;
      gap: 48px;
    }

    .samyak-hero-left {
      width: 100%;
      padding-left: 0;
      padding-right: 0;
      align-items: center;
      text-align: center;
    }

    .samyak-hero-headline {
      font-size: 38px;
    }

    .samyak-ornament-divider {
      justify-content: center;
    }

    .samyak-botanical-top,
    .samyak-botanical-bottom {
      display: none;
    }

    .samyak-hero-right {
      width: 100%;
      justify-content: center;
      padding-right: 0;
    }

    .samyak-collage-wrapper {
      justify-content: center;
    }

    .samyak-photo-portrait-box {
      width: 220px;
      height: 310px;
    }

    .samyak-photo-flatlay-box {
      width: 190px;
      height: 230px;
      margin-left: -32px;
      margin-top: 36px;
    }
  }

  @media screen and (max-width: 600px) {
    .samyak-editorial-hero {
      padding: 40px 16px 50px;
    }

    .samyak-hero-headline {
      font-size: 32px;
    }

    .samyak-inner-pill-btn {
      padding: 11px 22px;
      font-size: 11px;
    }

    .samyak-photo-portrait-box {
      width: 175px;
      height: 245px;
    }

    .samyak-photo-flatlay-box {
      width: 155px;
      height: 185px;
      margin-left: -24px;
      margin-top: 24px;
      border-width: 3px;
    }
  }
</style>
