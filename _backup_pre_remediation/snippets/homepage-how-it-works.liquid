{% doc %}
  Renders the 4-step wholesale purchasing process for Samyak Hair Accessories wholesale homepage.
{% enddoc %}

<div class="samyak-process-section">
  <div class="samyak-process-container">
    <div class="samyak-process-header">
      <span class="samyak-section-eyebrow">EFFORTLESS B2B PROCUREMENT</span>
      <h2 class="samyak-section-title">How Wholesale Ordering Works</h2>
      <p class="samyak-section-subtitle">Simplified ordering for business owners with transparent pricing and fast logistics.</p>
    </div>

    <div class="samyak-process-grid">
      <div class="samyak-process-step">
        <div class="samyak-process-step__number">01</div>
        <h3 class="samyak-process-step__title">Browse & Select</h3>
        <p class="samyak-process-step__text">
          Explore 15+ curated wholesale categories. Clear per-piece and per-card rates with no hidden distributor commissions.
        </p>
      </div>

      <div class="samyak-process-step">
        <div class="samyak-process-step__number">02</div>
        <h3 class="samyak-process-step__title">Reach ₹2,000 MOQ</h3>
        <p class="samyak-process-step__text">
          Mix and match any quantity across categories. Add at least ₹2,000 worth of merchandise to unlock wholesale shipping.
        </p>
      </div>

      <div class="samyak-process-step">
        <div class="samyak-process-step__number">03</div>
        <h3 class="samyak-process-step__title">Instant Checkout / WhatsApp</h3>
        <p class="samyak-process-step__text">
          Complete payment online with UPI / NetBanking / Cards, or share your cart directly with our dedicated WhatsApp manager.
        </p>
      </div>

      <div class="samyak-process-step">
        <div class="samyak-process-step__number">04</div>
        <h3 class="samyak-process-step__title">Insured Pan-India Dispatch</h3>
        <p class="samyak-process-step__text">
          Quality-checked and packed securely in heavy-duty corrugated cartons. Dispatched within 24–48 hours with live AWB tracking.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .samyak-process-section {
    width: 100%;
    padding-block: clamp(40px, 6vw, 68px);
    background: #F7F5EE;
    border-bottom: 1px solid #E4E0D6;
  }

  .samyak-process-container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .samyak-process-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 36px;
  }

  .samyak-process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }

  .samyak-process-step {
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    border-radius: 10px;
    background: #FCFBF7;
    border: 1px solid #E4E0D6;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .samyak-process-step:hover {
    transform: translateY(-3px);
    border-color: #113B32;
    box-shadow: 0 8px 24px rgba(17, 59, 50, 0.06);
  }

  .samyak-process-step__number {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 32px;
    font-weight: 500;
    color: #113B32;
    line-height: 1;
    margin-bottom: 14px;
    font-feature-settings: 'tnum';
  }

  .samyak-process-step__title {
    margin: 0 0 8px;
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 18px;
    font-weight: 500;
    color: #181A19;
    line-height: 1.3;
  }

  .samyak-process-step__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: #5C615E;
  }

  @media (max-width: 980px) {
    .samyak-process-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 540px) {
    .samyak-process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
