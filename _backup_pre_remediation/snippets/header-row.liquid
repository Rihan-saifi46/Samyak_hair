{% doc %}
  Renders the 3-zone integrated header row for Samyak Hair Accessories.
  - Left Zone: Stylized emerald & gold Brand Logo.
  - Center Zone: 2-Row Stacked Search + Navigation Links.
  - Right Zone: Action Icons (Bag, Heart, Profile).
  - Background: #F6F4EE, Padding: 16px 36px 14px.
{% enddoc %}

{%- liquid
  if row == 'top'
    assign show_row = true
  else
    assign show_row = false
  endif
-%}

{%- if show_row -%}
  <div class="samyak-header-3zone-bar">
    <!-- Left Zone: Brand Logo -->
    <div class="samyak-hdr-col samyak-hdr-col--left">
      {{ logo }}
    </div>

    <!-- Center Zone: 2-Row Stacked Search + Nav Links -->
    <div class="samyak-hdr-col samyak-hdr-col--center">
      {{ search }}
    </div>

    <!-- Right Zone: Action Icons -->
    <div class="samyak-hdr-col samyak-hdr-col--right">
      {{ actions }}
    </div>
  </div>

  <style>
    .header__row--top,
    .samyak-header-3zone-bar {
      background-color: #F6F4EE !important;
      width: 100%;
      box-sizing: border-box;
    }

    .samyak-header-3zone-bar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      padding: 16px 36px 14px;
      gap: 24px;
      max-width: 100%;
    }

    .samyak-hdr-col--left {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      flex-shrink: 0;
    }

    .samyak-hdr-col--center {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
    }

    .samyak-hdr-col--right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-shrink: 0;
    }

    #header-component,
    .header-section {
      background-color: #F6F4EE !important;
      border-bottom: 1px solid rgba(200, 195, 184, 0.45);
    }

    .header__row--bottom {
      display: none !important;
    }

    @media screen and (max-width: 1024px) {
      .samyak-header-3zone-bar {
        padding: 12px 18px;
        gap: 14px;
      }
    }
  </style>
{%- endif -%}
