{% doc %}
  Renders the 4-pillar trust indicators bar for Samyak Hair Accessories wholesale storefront.
{% enddoc %}

<div class="samyak-trust-bar">
  <div class="samyak-trust-bar__container">
    <div class="samyak-trust-bar__grid">
      <div class="samyak-trust-card">
        <div class="samyak-trust-card__icon-wrap">
          <svg class="samyak-trust-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        </div>
        <div class="samyak-trust-card__body">
          <h3 class="samyak-trust-card__title">Direct Factory Sourcing</h3>
          <p class="samyak-trust-card__text">Direct China & Korea shipments. Sadar Bazar competitive pricing with no middleman markup.</p>
        </div>
      </div>

      <div class="samyak-trust-card">
        <div class="samyak-trust-card__icon-wrap">
          <svg class="samyak-trust-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><line x1="12" y1="6" x2="12" y2="8"></line><line x1="12" y1="16" x2="12" y2="18"></line></svg>
        </div>
        <div class="samyak-trust-card__body">
          <h3 class="samyak-trust-card__title">Low ₹2,000 Minimum Order</h3>
          <p class="samyak-trust-card__text">Ideal for boutique owners and Instagram resellers to test trending stock with low capital.</p>
        </div>
      </div>

      <div class="samyak-trust-card">
        <div class="samyak-trust-card__icon-wrap">
          <svg class="samyak-trust-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        </div>
        <div class="samyak-trust-card__body">
          <h3 class="samyak-trust-card__title">Pan-India Express Dispatch</h3>
          <p class="samyak-trust-card__text">Orders dispatched within 24–48 hours in shock-proof master boxes with live tracking.</p>
        </div>
      </div>

      <div class="samyak-trust-card">
        <div class="samyak-trust-card__icon-wrap">
          <svg class="samyak-trust-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div class="samyak-trust-card__body">
          <h3 class="samyak-trust-card__title">100% GST Tax Invoicing</h3>
          <p class="samyak-trust-card__text">Legitimate tax invoice generated with your business GSTIN for full Input Tax Credit (ITC).</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .samyak-trust-bar {
    width: 100%;
    background: #FAF8F3;
    border-bottom: 1px solid #E4E0D6;
    padding-block: 28px;
  }

  .samyak-trust-bar__container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .samyak-trust-bar__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.5vw, 32px);
  }

  .samyak-trust-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .samyak-trust-card__icon-wrap {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(17, 59, 50, 0.08);
    color: #113B32;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .samyak-trust-card__body {
    min-width: 0;
  }

  .samyak-trust-card__title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: #181A19;
    line-height: 1.25;
  }

  .samyak-trust-card__text {
    margin: 0;
    font-size: 12.5px;
    color: #5C615E;
    line-height: 1.45;
  }

  @media (max-width: 980px) {
    .samyak-trust-bar__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
    }
  }

  @media (max-width: 480px) {
    .samyak-trust-bar {
      padding-block: 20px;
    }
    .samyak-trust-card {
      gap: 10px;
    }
    .samyak-trust-card__icon-wrap {
      width: 38px;
      height: 38px;
    }
    .samyak-trust-card__title {
      font-size: 13px;
    }
    .samyak-trust-card__text {
      font-size: 11px;
    }
  }
</style>
